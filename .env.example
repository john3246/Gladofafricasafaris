NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000
# Set USE_DB=false to run from src/data seed files (no Postgres/Redis needed)
USE_DB=true
DATABASE_URL=postgresql://glad:glad@localhost:5433/glad_safari   # local: npm run db:local (port 5433). Docker compose uses 5432.
REDIS_URL=redis://localhost:6379
PAGE_CACHE_TTL=600

# CMS: the owner account is created on first start when the user table is empty.
ADMIN_EMAIL=admin@gladofafricasafari.com
ADMIN_PASSWORD=choose-a-long-unique-password
SESSION_SECRET=generate-a-long-random-string
# Optional: e-mail alerts for new quote requests (nodemailer SMTP URL) and sender name
# SMTP_URL=smtps://user:password@smtp.example.com
# MAIL_FROM=Glad Of Africa <info@gladofafricasafari.com>
HOST=127.0.0.1   # optional: listen on localhost only (use behind nginx)
