<%- include('partials/page-hero', { title: L.h1.replace(/&/g, '&amp;').replace(/</g, '&lt;'), sub: L.sub, image: '/images/destinations/ngorongoro-crater.webp' }) %>

<section class="bg-white py-10 sm:py-14">
  <div class="container-site max-w-4xl">
    <p class="text-[17px] leading-relaxed text-ink/80"><%= L.intro %></p>
    <% L.sections.forEach(function (s) { %>
      <h2 class="mt-10 !text-2xl"><%= s.h %></h2>
      <% (s.p || []).forEach(function (para) { %><p class="mt-3 leading-relaxed text-ink/80"><%= para %></p><% }) %>
      <% if (s.ul) { %><ul class="check-list mt-3 space-y-2 text-[15.5px] text-ink/85"><% s.ul.forEach(function (li) { %><li><%= li %></li><% }) %></ul><% } %>
    <% }) %>
  </div>
</section>

<section class="bg-sand py-12">
  <div class="container-site max-w-3xl">
    <h2 class="mb-6 !text-2xl">Questions about travel insurance</h2>
    <%- include('partials/faq-list', { faqs: L.faqs }) %>
  </div>
</section>
<%- include('partials/cta-band') %>
