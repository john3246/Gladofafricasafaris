<%- include('partials/page-hero', { title: 'Tanzania safari <em>offers</em>', sub: 'Calving season safaris and safari-and-beach holidays, picked by our team. Prices are per person; every itinerary can be tailored.', image: '/images/destinations/serengeti-national-park.webp' }) %>

<section class="bg-white py-10 sm:py-12">
  <div class="container-site max-w-4xl text-center">
    <p class="eyebrow">Our offers</p>
    <h2 class="mt-2">Pick a season, <em>pick a safari</em></h2>
    <p class="mt-3 text-ink/70">Each offer is a real itinerary with a real price. Nothing is hidden: the quote you receive lists what is included. Travel insurance with medical cover is required for every guest (<a class="font-bold text-forest-500 underline" href="/travel-insurance">read the requirements</a>).</p>
  </div>
</section>

<%- include('partials/quick-facts', { facts: facts, heading: 'Safari prices at a glance' }) %>
<%- include('partials/finder', { finder: finder }) %>

<% groups.forEach(function (g, gi) { %>
  <section class="<%= gi % 2 ? 'bg-white' : 'bg-sand' %> py-10 sm:py-14">
    <div class="container-site">
      <p class="eyebrow">Offer</p>
      <h2 class="mt-2"><%= g.label %></h2>
      <% if (g.note) { %><p class="mt-2 max-w-3xl text-ink/70"><%= g.note %></p><% } %>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        <% g.tours.forEach(function (tour) { %><%- include('partials/tour-card', { tour: tour }) %><% }) %>
      </div>
    </div>
  </section>
<% }) %>
<% if (!groups.length) { %><section class="bg-white py-16"><div class="container-site text-center"><p class="text-ink/70">No offers are running right now. <a class="font-bold text-forest-500 underline" href="/get-a-quote">Ask us</a> and we will plan your safari for your dates.</p></div></section><% } %>

<section class="bg-white py-12">
  <div class="container-site max-w-3xl">
    <p class="eyebrow">Questions</p>
    <h2 class="mt-2 mb-6">About our <em>offers</em></h2>
    <%- include('partials/faq-list', { faqs: faqs }) %>
  </div>
</section>
<%- include('partials/cta-band') %>
