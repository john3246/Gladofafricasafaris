<%- include('partials/page-hero', { title: page.title, sub: page.subtitle, image: '/images/experiences/1.webp' }) %>
<section class="bg-white py-12 md:py-16">
  <div class="container-site grid items-center gap-10 lg:grid-cols-2">
    <div class="prose-site">
      <p class="eyebrow">About us</p>
      <%- page.body %>
      <h2>Visit us</h2>
      <p><%= site.address.street %>-<%= site.address.city %>, <%= site.address.countryName %></p>
      <a href="/get-a-quote" class="btn-primary mt-4">Plan your safari</a>
    </div>
    <div class="media-box aspect-[4/3]"><img src="/images/gallery/glad-9840.webp" alt="Glad Of Africa safari vehicle beside a giant baobab in Tarangire" width="900" height="680" loading="lazy"></div>
  </div>
</section>
<%- include('partials/quick-facts', { facts: facts, heading: 'Our safaris and prices' }) %>
<section class="bg-sand py-12">
  <div class="container-site">
    <p class="eyebrow">On the road</p>
    <h2 class="mt-2">Our team in <em>the field</em></h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% ['glad-9817', 'glad-9873', 'glad-9899', 'glad-9940', 'cheetah', 'glad-9993'].forEach(function (n) { %>
        <div class="media-box aspect-[4/3]"><img src="/images/gallery/<%= n %>.webp" alt="Glad Of Africa safari vehicle and wildlife in Tanzania" width="800" height="600" loading="lazy"></div>
      <% }) %>
    </div>
  </div>
</section>
<%- include('partials/reviews') %>
<%- include('partials/cta-band') %>
