<%- include('partials/page-hero', { title: destination.name, sub: destination.tagline, image: destination.image }) %>
<section class="bg-white py-12 md:py-16">
  <div class="container-site grid gap-10 lg:grid-cols-[minmax(0,1fr)_340px]">
    <div class="prose-site">
      <p class="eyebrow">Why go</p>
      <h2 class="!mt-2">Discover what makes <em><%= destination.name %></em> special</h2>
      <% destination.intro.forEach(function (p) { %><p><%= p %></p><% }) %>
      <% if (destination.bestTime) { %><h2>When to visit</h2><p><%= destination.bestTime %></p><% } %>
      <% if (destination.wildlife.length) { %>
        <h2>Wildlife you may see</h2>
        <ul class="check-list !list-none !pl-0 grid grid-cols-2 gap-x-6 gap-y-1"><% destination.wildlife.forEach(function (w) { %><li><%= w %></li><% }) %></ul>
      <% } %>
    </div>
    <aside class="h-fit bg-sand p-6 lg:sticky lg:top-28">
      <p class="eyebrow">Plan your trip</p>
      <h2 class="mt-1 !text-3xl">Tailor your dream safari, your way</h2>
      <p class="mt-3 text-sm">Tell us how you want to explore <%= destination.name %> and we will craft a custom safari with top regions, lodges and unforgettable wildlife experiences.</p>
      <a href="/get-a-quote" class="btn-primary mt-5 w-full">Talk to us</a>
    </aside>
  </div>
</section>
<% if (tours.length) { %>
<section class="bg-sand py-12">
  <div class="container-site">
    <p class="eyebrow">Tour options</p>
    <h2 class="mt-2">Safaris that include <em><%= destination.name %></em></h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <% tours.slice(0, 8).forEach(function (tour) { %><%- include('partials/tour-card', { tour: tour }) %><% }) %>
    </div>
  </div>
</section>
<% } %>
<section class="bg-white py-12">
  <div class="container-site">
    <h2>More destinations</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      <% others.forEach(function (d) { %><%- include('partials/destination-card', { d: d }) %><% }) %>
    </div>
  </div>
</section>
