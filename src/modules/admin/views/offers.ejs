<div class="mb-5 flex flex-wrap items-center justify-between gap-3">
  <div><h1>Offers and where clients come from</h1><p class="text-sm text-ink/55">The safaris that carry an offer label (<%= offerCount %> now), how many people looked at each, how many asked for a quote, and from which countries. To add or remove an offer, edit the safari and fill in "Special offer label".</p></div>
  <nav class="flex gap-1 rounded-lg bg-white p-1 text-sm font-semibold ring-1 ring-black/5">
    <% [7, 30, 90].forEach(function (d) { %><a href="/admin/offers?days=<%= d %><%= all ? '&all=1' : '' %>" class="rounded-md px-4 py-1.5 <%= days === d ? 'bg-forest-500 text-white' : 'hover:bg-mist' %>"><%= d %> days</a><% }) %>
  </nav>
</div>
<p class="mb-3 text-sm"><a class="font-semibold text-forest-500 underline" href="/admin/offers?days=<%= days %><%= all ? '' : '&all=1' %>"><%= all ? 'Show only offers' : 'Show every safari' %></a> &middot; <a class="font-semibold text-forest-500 underline" href="/admin/analytics#countries">Countries overview</a></p>

<div class="a-card overflow-x-auto">
  <table class="a-table w-full min-w-[860px]">
    <thead><tr><th>Safari</th><th>Offer</th><th class="!text-right">Views</th><th>Viewed from</th><th class="!text-right">Quote requests</th><th>Clients from</th></tr></thead>
    <tbody>
      <% rows.forEach(function (r) { %>
        <tr>
          <td class="max-w-[280px]"><a class="font-semibold hover:text-forest-500" href="/admin/tours/<%= r.slug %>/edit"><%= r.title %></a><span class="block text-xs text-ink/50"><%= r.days %> days · from $<%= Number(r.price).toLocaleString('en-US') %> · <a class="underline" target="_blank" rel="noopener" href="/tours/<%= r.slug %>">view on site</a></span></td>
          <td><% if (r.label) { %><span class="a-badge-green"><%= r.label %></span><% } else { %><span class="text-xs text-ink/40">not an offer</span><% } %></td>
          <td class="text-right font-semibold"><%= r.views %></td>
          <td class="text-xs"><% r.viewCountries.forEach(function (c, i) { %><%= i ? ', ' : '' %><%= c.name %> (<%= c.count %>)<% }) %><% if (!r.viewCountries.length) { %>-<% } %></td>
          <td class="text-right font-semibold"><%= r.asks %></td>
          <td class="text-xs"><% r.askCountries.forEach(function (c, i) { %><%= i ? ', ' : '' %><%= c.name %> (<%= c.count %>)<% }) %><% if (!r.askCountries.length) { %>-<% } %></td>
        </tr>
      <% }) %>
      <% if (!rows.length) { %><tr><td colspan="6" class="py-10 text-center text-ink/50">No offers yet. Edit a safari and fill in "Special offer label".</td></tr><% } %>
    </tbody>
  </table>
</div>
<p class="mt-3 text-xs text-ink/50">Views count real visitors only (search-engine robots are left out). A quote request is linked to a safari when the guest started it from that safari's page or chose it in the form. Countries come from the visitor's connection; VPN users show the VPN's country.</p>
