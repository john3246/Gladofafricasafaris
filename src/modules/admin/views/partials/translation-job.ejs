<%# Progress of the translation job. param: job %>
<% const pct = job.total ? Math.min(100, Math.round((job.done / job.total) * 100)) : 0; %>
<div class="a-card p-4 <%= job.running ? 'border-2 border-forest-400/60' : '' %>">
  <p class="text-sm font-semibold"><%= job.running ? 'Working: ' + job.step + (job.lang ? ' (' + job.lang.toUpperCase() + ')' : '') : (job.finishedAt ? 'Last job: ' + job.step : 'No job has run since the server started') %></p>
  <% if (job.running || job.total) { %><div class="mt-2 h-2 rounded-full bg-mist"><div class="h-2 rounded-full bg-forest-500" style="width: <%= pct %>%"></div></div>
  <p class="mt-1 text-xs text-ink/55"><%= job.done %> of <%= job.total %><%= job.rejected ? ' · ' + job.rejected + ' sentences were refused by the checks and stay untranslated' : '' %><%= job.cost ? ' · about $' + job.cost.toFixed(2) + ' so far' : '' %></p><% } %>
  <% if (job.error) { %><p class="mt-2 text-sm text-red-700"><%= job.error %></p><% } %>
</div>
