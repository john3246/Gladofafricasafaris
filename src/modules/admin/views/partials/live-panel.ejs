<%# Live panel: visitors on the site now, views per minute, new inquiries and the latest CMS activity. param: live %>
<%
  const rt = live.rt;
  const peak = Math.max(1, ...rt.minutes);
  const when = (d) => new Date(d).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
%>
<section class="a-card p-5" data-alert="<%= live.newInquiries %>">
  <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
    <h2 class="flex items-center gap-2"><span class="relative flex h-2.5 w-2.5"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-500 opacity-60"></span><span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-green-600"></span></span> Live now</h2>
    <span class="text-xs text-ink/50">Updates every few seconds &middot; last update <span data-live-time><%= when(rt.at) %></span></span>
  </div>
  <div class="grid gap-5 lg:grid-cols-[1fr_1.2fr_1.2fr]">
    <div>
      <p class="text-4xl font-bold leading-none"><%= rt.active %></p>
      <p class="mt-1 text-sm text-ink/60">visitor<%= rt.active === 1 ? '' : 's' %> on the site in the last 5 minutes</p>
      <p class="mt-3 text-sm"><strong><%= rt.viewsToday.toLocaleString('en-US') %></strong> page views today</p>
      <p class="text-sm"><strong><%= rt.last30 %></strong> in the last 30 minutes</p>
      <a href="/admin/inquiries" class="mt-3 inline-flex items-center gap-2 text-sm font-semibold <%= live.newInquiries ? 'text-forest-500' : 'text-ink/55' %>"><%= live.newInquiries %> new inquir<%= live.newInquiries === 1 ? 'y' : 'ies' %> waiting &rarr;</a>
    </div>
    <div>
      <p class="mb-2 text-xs font-bold uppercase tracking-wider text-ink/50">Page views per minute (last 30 min)</p>
      <div class="flex h-16 items-end gap-[3px]" role="img" aria-label="Page views per minute for the last 30 minutes"><% rt.minutes.forEach(function (n) { %><span class="flex-1 rounded-sm bg-forest-500/80" style="height: <%= n ? Math.max(6, Math.round((n / peak) * 100)) : 0 %>%" title="<%= n %> views"></span><% }) %></div>
      <p class="mb-1 mt-4 text-xs font-bold uppercase tracking-wider text-ink/50">Pages being read now</p>
      <ul class="space-y-1 text-sm"><% rt.pages.forEach(function (p) { %><li class="flex justify-between gap-3"><span class="truncate"><%= p.name %></span><strong><%= p.count %></strong></li><% }) %>
      <% if (!rt.pages.length) { %><li class="text-ink/50">Nobody on the site right now.</li><% } %></ul>
    </div>
    <div>
      <p class="mb-2 text-xs font-bold uppercase tracking-wider text-ink/50">Latest CMS activity</p>
      <ul class="space-y-2 text-sm"><% live.latest.forEach(function (e) { %>
        <li><span class="font-semibold"><%= e.user %></span> <span class="text-ink/60"><%= e.action %></span> <span class="text-ink/50">&middot; <%= e.title || e.key %></span>
          <span class="block text-xs text-ink/45"><%= when(e.at) %><% if (e.where) { %> &middot; <%= e.where %><% } %><% if (e.ip) { %> &middot; <%= e.ip %><% } %></span></li>
      <% }) %><% if (!live.latest.length) { %><li class="text-ink/50">No activity yet.</li><% } %></ul>
      <a class="mt-2 inline-block text-xs font-semibold text-forest-500" href="/admin/audit">Full audit log &rarr;</a>
    </div>
  </div>
</section>
