<p class="text-sm text-ink/55"><a class="hover:underline" href="/admin/users">Users & Roles</a> / Invite</p>
<h1 class="mb-1 mt-1">Invite a user</h1>
<p class="mb-5 max-w-xl text-sm text-ink/60">They receive a one-time link, choose their own name and password, and nobody else ever sees that password. The link works once and lasts 3 days.</p>
<form method="post" action="/admin/users/invite" class="a-card max-w-xl p-6" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label class="a-label" for="email">Their email address</label>
  <input class="input mb-1" id="email" name="email" type="email" value="<%= values.email || '' %>" required autofocus>
  <% if (errors.email) { %><p class="a-err"><%= errors.email %></p><% } %>
  <label class="a-label mt-4" for="role">Role</label>
  <select class="input" id="role" name="role"><% ROLES.forEach(function (r) { %><option value="<%= r %>" <%= values.role === r ? 'selected' : '' %>><%= r === 'admin' ? 'Administrator (everything)' : 'Editor (content only)' %></option><% }) %></select>
  <label class="mt-4 flex items-center gap-2 text-sm font-medium"><input type="checkbox" name="send" value="1" class="h-4 w-4 accent-forest-500" <%= mailOk ? 'checked' : 'disabled' %>> Email the invitation <%= mailOk ? '' : '(email is not set up yet: you will get a link to send yourself)' %></label>
  <div class="mt-6 flex gap-2"><button class="a-btn-primary">Create invitation</button><a href="/admin/users" class="a-btn-ghost">Cancel</a></div>
</form>
