<p class="text-sm text-ink/55"><a class="hover:underline" href="/admin/users">Users & Roles</a> / <%= heading %></p>
<h1 class="mb-5 mt-1"><%= heading %></h1>
<section class="a-card max-w-2xl p-6">
  <p class="text-sm">For <strong><%= who %></strong></p>
  <% if (emailed && emailed.ok) { %><p class="mt-3 rounded-lg border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-800">The email was sent.</p>
  <% } else if (emailed) { %><p class="mt-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">The email could not be sent (<%= emailed.reason %>). Copy the link below and send it yourself.</p><% } %>
  <label class="a-label mt-4" for="link">One-time link (works once, valid <%= lifetime %>)</label>
  <div class="flex gap-2"><input class="input font-mono text-[12px]" id="link" value="<%= url %>" readonly><button type="button" class="a-btn-primary shrink-0" data-copy="#link">Copy</button></div>
  <p class="a-help mt-2">This is the only time the link is shown. If you lose it, create a new one: the old link stops working.</p>
  <a href="/admin/users" class="a-btn-ghost mt-5">Back to users</a>
</section>
