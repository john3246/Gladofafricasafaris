<div class="mb-5 flex flex-wrap items-center justify-between gap-3">
  <div><h1>Media Library</h1><p class="text-sm text-ink/55">Photos used across the website. Uploads are resized and converted to fast WebP automatically.</p></div>
</div>

<form id="upload-form" method="post" action="/admin/media/upload?_csrf=<%= csrf %>" enctype="multipart/form-data" class="a-card mb-5 flex flex-wrap items-center gap-4 border-2 border-dashed border-forest-400/50 p-5" data-dropzone>
  <span class="flex h-12 w-12 items-center justify-center rounded-full bg-green-100 text-forest-600"><%- include('../partials/icon', { n: 'upload', s: 24 }) %></span>
  <div class="min-w-0 flex-1"><p class="font-semibold">Upload photos</p><p class="text-sm text-ink/55">Drop JPG, PNG or WebP files here (up to 12 at a time, 12 MB each) or choose them.</p></div>
  <input type="file" name="files" accept="image/jpeg,image/png,image/webp,image/gif" multiple required class="max-w-[240px] text-sm">
  <button class="a-btn-primary">Upload</button>
</form>

<div class="mb-4 flex flex-wrap items-center gap-3">
  <nav class="flex gap-1 rounded-lg bg-white p-1 text-sm font-semibold ring-1 ring-black/5">
    <a href="/admin/media" class="rounded-md px-4 py-1.5 <%= tab === 'uploads' ? 'bg-forest-500 text-white' : 'hover:bg-mist' %>">My uploads</a>
    <a href="/admin/media?tab=site" class="rounded-md px-4 py-1.5 <%= tab === 'site' ? 'bg-forest-500 text-white' : 'hover:bg-mist' %>">Website images</a>
  </nav>
  <form method="get" class="flex-1"><input type="hidden" name="tab" value="<%= tab %>"><input class="input !py-2" name="q" value="<%= q %>" placeholder="Search by file name..."></form>
  <span class="text-sm text-ink/55"><%= total %> image<%= total === 1 ? '' : 's' %></span>
</div>

<div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5 xl:grid-cols-6">
  <% items.forEach(function (m) { %>
    <figure class="a-card group overflow-hidden">
      <div class="media-box aspect-square"><img src="<%= m.url %>" alt="<%= m.name %>" loading="lazy"></div>
      <figcaption class="p-2.5 text-xs">
        <p class="truncate font-semibold" title="<%= m.name %>"><%= m.name %></p>
        <p class="text-ink/50"><%= m.size ? Math.round(m.size / 1024) + ' KB' : (m.folder || '') %></p>
        <div class="mt-2 flex items-center gap-1">
          <button type="button" data-copy="<%= m.url %>" class="a-btn-ghost !px-2 !py-1 text-[11px]"><%- include('../partials/icon', { n: 'link', s: 13 }) %> Copy link</button>
          <% if (m.kind === 'upload') { %><form method="post" action="/admin/media/<%= m.id %>/delete" class="ml-auto"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="rounded p-1.5 text-red-700 hover:bg-red-50" data-confirm="Delete this image?" aria-label="Delete"><%- include('../partials/icon', { n: 'trash', s: 15 }) %></button></form><% } %>
        </div>
      </figcaption>
    </figure>
  <% }) %>
</div>
<% if (!items.length) { %><p class="a-card p-10 text-center text-ink/50"><%= tab === 'uploads' ? 'No uploads yet. Use the box above to add your first photo.' : 'No images match.' %></p><% } %>
