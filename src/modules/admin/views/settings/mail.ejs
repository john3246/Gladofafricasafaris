<div class="mb-5">
  <h1>Email</h1>
  <p class="text-sm text-ink/55">Who the website's emails come from, who is alerted about new requests, and the connection to your mail server.</p>
</div>

<div class="grid items-start gap-6 xl:grid-cols-[minmax(0,1fr)_380px]">
  <form method="post" action="/admin/mail" class="space-y-6">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <section class="a-card p-5 md:p-6">
      <h2 class="mb-1">Sender</h2>
      <p class="a-help mb-4">What guests see in their inbox. The address must be a mailbox your mail server allows to send (normally the same mailbox as the SMTP login).</p>
      <div class="grid gap-4 sm:grid-cols-2">
        <div><label class="a-label" for="mailFromName">From name</label><input class="input" id="mailFromName" name="mailFromName" value="<%= s.mailFromName %>" placeholder="<%= from.name %>"></div>
        <div><label class="a-label" for="mailFromEmail">From address</label><input class="input" id="mailFromEmail" name="mailFromEmail" type="email" value="<%= s.mailFromEmail %>" placeholder="<%= from.address %>"></div>
        <div class="sm:col-span-2"><label class="a-label" for="mailReplyTo">Replies go to</label><input class="input" id="mailReplyTo" name="mailReplyTo" type="email" value="<%= s.mailReplyTo %>" placeholder="<%= siteEmail %>"><p class="a-help">Where a guest's reply lands when they answer an email from the website.</p></div>
      </div>
    </section>

    <section class="a-card p-5 md:p-6">
      <h2 class="mb-1">New requests</h2>
      <p class="a-help mb-4">What happens when someone sends the quote form.</p>
      <div class="space-y-4">
        <label class="flex items-center gap-2.5 text-sm font-medium"><input type="hidden" name="notifyTeam" value="0"><input type="checkbox" name="notifyTeam" value="1" class="h-4 w-4 accent-forest-500" <%= s.notifyTeam !== false ? 'checked' : '' %>> Email my team about every new request</label>
        <div><label class="a-label" for="notifyEmail">Team addresses (one or several, separated by commas)</label><textarea class="input" id="notifyEmail" name="notifyEmail" rows="2" placeholder="<%= siteEmail %>"><%= s.notifyEmail %></textarea></div>
        <div><label class="a-label" for="mailBcc">Hidden copy (BCC) of every email sent</label><input class="input" id="mailBcc" name="mailBcc" value="<%= s.mailBcc %>" placeholder="optional, e.g. the owner"></div>
        <label class="flex items-center gap-2.5 text-sm font-medium"><input type="hidden" name="autoReplyGuest" value="0"><input type="checkbox" name="autoReplyGuest" value="1" class="h-4 w-4 accent-forest-500" <%= s.autoReplyGuest !== false ? 'checked' : '' %>> Send the guest an automatic "we received your request" email</label>
      </div>
      <p class="a-help mt-4">The texts of these emails are in <a class="font-semibold text-forest-500 underline" href="/admin/email-templates">Email templates</a>.</p>
    </section>
    <button class="a-btn-primary"><%- include('../partials/icon', { n: 'check', s: 16 }) %> Save email settings</button>
  </form>

  <aside class="space-y-6 xl:sticky xl:top-20">
    <section class="a-card p-5">
      <h2 class="mb-1">Mail server login</h2>
      <% if (smtp.configured && !smtp.invalid) { %>
        <p class="mb-2"><span class="a-badge-green">Connected settings found</span> <span class="text-xs text-ink/55">(<%= smtp.test ? 'test mode' : smtp.source === 'cms' ? 'saved here' : 'from the server file' %>)</span></p>
        <% if (!smtp.test) { %><p class="mb-3 text-sm text-ink/70"><%= smtp.user %> on <%= smtp.host %>:<%= smtp.port %> (<%= smtp.secure ? 'SSL' : 'STARTTLS' %>)</p><% } %>
      <% } else { %>
        <p class="mb-2"><span class="a-badge-amber"><%= smtp.invalid ? 'The server file setting is not valid' : 'Not set up yet' %></span></p>
      <% } %>
      <% if (server && server.hasPassword && !server.readable) { %><p class="mb-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-900">The saved password can no longer be read (the server secret changed). Enter it again below.</p><% } %>
      <form method="post" action="/admin/mail/server" class="space-y-3" autocomplete="off">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div><label class="a-label" for="host">Mail server</label><input class="input" id="host" name="host" value="<%= server ? server.host : '' %>" placeholder="mail.yourdomain.com" required></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="a-label" for="port">Port</label><input class="input" id="port" name="port" type="number" value="<%= server ? server.port : 465 %>" required></div>
          <div><label class="a-label" for="security">Security</label><select class="input" id="security" name="security"><option value="ssl" <%= !server || server.security !== 'starttls' ? 'selected' : '' %>>SSL (465)</option><option value="starttls" <%= server && server.security === 'starttls' ? 'selected' : '' %>>STARTTLS (587)</option></select></div>
        </div>
        <div><label class="a-label" for="user">Mailbox login</label><input class="input" id="user" name="user" value="<%= server ? server.user : '' %>" placeholder="info@yourdomain.com" required></div>
        <div><label class="a-label" for="password">Mailbox password</label><input class="input" id="password" name="password" type="password" autocomplete="new-password" placeholder="<%= server && server.hasPassword && server.readable ? '•••••••• saved, leave empty to keep' : 'type the password' %>"></div>
        <button class="a-btn-primary w-full">Save mail server login</button>
        <p class="a-help">The password is stored encrypted on the server and is never shown again. Use the same mailbox as the "From address" on the left. cPanel: Email Accounts &gt; Connect Devices shows the server name and ports.</p>
      </form>
      <% if (server) { %><form method="post" action="/admin/mail/server" class="mt-3"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="remove" value="1"><button class="text-xs font-semibold text-red-700 hover:underline" data-confirm="Remove the saved mail server login? Emails stop sending.">Remove the saved login</button></form><% } %>
    </section>
    <section class="a-card p-5">
      <h2 class="mb-3">Send a test email</h2>
      <form method="post" action="/admin/mail/test" class="space-y-3">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div><label class="a-label" for="to">Send to</label><input class="input" id="to" name="to" type="email" value="<%= user.email %>" required></div>
        <div><label class="a-label" for="template">Template</label>
          <select class="input" id="template" name="template"><% templates.forEach(function (t) { %><option value="<%= t.key %>" <%= t.key === 'inquiry-guest' ? 'selected' : '' %>><%= t.name %></option><% }) %></select></div>
        <button class="a-btn-ghost w-full" <%= smtp.configured ? '' : 'disabled' %>><%- include('../partials/icon', { n: 'send', s: 16 }) %> Send test</button>
        <p class="a-help">Checks the login first, then sends the template filled with sample guest details.</p>
      </form>
    </section>
  </aside>
</div>
