<div class="mb-5 flex flex-wrap items-center justify-between gap-3">
  <div><h1>Accommodation photos</h1><p class="text-sm text-ink/55">Give each lodge, camp or hotel its own photo. Places without one show a photo of the area. <%= counts.own %> of <%= counts.total %> have their own photo.</p></div>
  <a class="a-btn-ghost" href="/admin/accommodations">All accommodations</a>
</div>

<form method="post" action="/admin/accommodation-photos/bulk?_csrf=<%= csrf %>" enctype="multipart/form-data" class="a-card mb-5 flex flex-wrap items-center gap-4 border-2 border-dashed border-forest-400/50 p-5">
  <span class="flex h-12 w-12 items-center justify-center rounded-full bg-green-100 text-forest-600"><%- include('partials/icon', { n: 'upload', s: 24 }) %></span>
  <div class="min-w-0 flex-1">
    <p class="font-semibold">Upload many photos at once</p>
    <p class="text-sm text-ink/55">Name each file after the place, for example <strong>kitela-lodge.jpg</strong>. A second photo of the same place: <strong>kitela-lodge-2.jpg</strong> (it goes into that place's gallery). Up to 40 files, 12 MB each.</p>
  </div>
  <input type="file" name="files" accept="image/jpeg,image/png,image/webp" multiple required class="max-w-[240px] text-sm">
  <button class="a-btn-primary">Upload and match</button>
</form>

<form method="get" class="mb-4 flex flex-wrap items-center gap-3">
  <input class="input !py-2 flex-1" name="q" value="<%= q %>" placeholder="Search by name or region...">
  <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="only" value="missing" <%= only ? 'checked' : '' %>> Only places without their own photo</label>
  <button class="a-btn-ghost">Filter</button>
</form>

<div class="a-card overflow-x-auto">
  <table class="a-table w-full min-w-[760px]">
    <thead><tr><th>Photo</th><th>Place</th><th>Photo status</th><th>Change</th></tr></thead>
    <tbody>
      <% items.forEach(function (d) { var own = d.image || d.imageUrl; var shown = own || d.areaImage; %>
        <tr id="p-<%= d.slug %>">
          <td class="w-24"><% if (shown) { %><img class="h-14 w-20 rounded object-cover" src="<%= shown %>" alt="" loading="lazy"><% } else { %><span class="text-xs text-ink/40">none</span><% } %></td>
          <td><strong><%= d.name %></strong><div class="text-xs text-ink/50"><%= d.region || 'No region' %> &middot; <%= d.kind || d.type || '' %></div></td>
          <td><% if (d.image) { %><span class="rounded bg-green-100 px-2 py-0.5 text-xs font-semibold text-green-800">Own photo<%= d.gallery && d.gallery.length ? ' + ' + d.gallery.length : '' %></span>
            <% } else if (d.imageUrl) { %><span class="rounded bg-blue-100 px-2 py-0.5 text-xs font-semibold text-blue-800">Linked photo</span>
            <% } else { %><span class="rounded bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800">Area photo</span><% } %></td>
          <td>
            <form method="post" action="/admin/accommodation-photos/<%= d.slug %>?_csrf=<%= csrf %>" enctype="multipart/form-data" class="flex flex-wrap items-center gap-2">
              <input type="file" name="file" accept="image/jpeg,image/png,image/webp" class="max-w-[180px] text-xs">
              <button class="a-btn-primary !px-3 !py-1.5">Upload</button>
            </form>
            <form method="post" action="/admin/accommodation-photos/<%= d.slug %>" class="mt-1.5 flex flex-wrap items-center gap-2">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input class="input !py-1.5 !text-xs" style="max-width:220px" name="imageUrl" value="<%= d.imageUrl || '' %>" placeholder="or a photo link https://...">
              <button class="a-btn-ghost !px-3 !py-1.5">Use link</button>
              <% if (own) { %><button name="action" value="clear" class="a-btn-ghost !px-3 !py-1.5" data-confirm="Go back to the area photo?">Remove</button><% } %>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (!items.length) { %><tr><td colspan="4" class="py-10 text-center text-ink/50">No places match.</td></tr><% } %>
    </tbody>
  </table>
</div>
<p class="mt-3 text-xs text-ink/50">Use a photo link only if the lodge or the photographer gave you permission. Links can stop working when the other website changes, so uploading the photo is safer.</p>
