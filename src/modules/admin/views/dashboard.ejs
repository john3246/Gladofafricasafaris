<%
  const today = new Date().toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
  const ST = { new: 'a-badge-blue', 'in-progress': 'a-badge-amber', replied: 'a-badge-green', booked: 'a-badge-green', closed: 'a-badge-gray',
    confirmed: 'a-badge-green', completed: 'a-badge-green', pending: 'a-badge-blue', 'pending-payment': 'a-badge-amber', cancelled: 'a-badge-red' };
  const money = (n) => '$' + Number(n || 0).toLocaleString('en-US');
  const short = (d) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
  const arrow = (n) => (n > 0 ? '▲ ' + n + '%' : n < 0 ? '▼ ' + Math.abs(n) + '%' : '– 0%');
  const cards = [
    ['Page views', stats.views.toLocaleString('en-US'), 'chart', 'bg-green-100 text-green-700', '/admin/analytics', stats.viewsDelta],
    ['Visitors', stats.visitors.toLocaleString('en-US'), 'users', 'bg-teal-100 text-teal-700', '/admin/analytics', stats.visitorsDelta],
    ['Inquiries', stats.inquiries, 'mail', 'bg-purple-100 text-purple-700', '/admin/inquiries', stats.inquiryDelta],
    ['Bookings', stats.bookings, 'calendar', 'bg-orange-100 text-orange-700', '/admin/bookings', null],
    ['Revenue (paid)', money(stats.revenue), 'dollar', 'bg-blue-100 text-blue-700', '/admin/bookings', null],
    ['Subscribers', stats.subscribers, 'send', 'bg-pink-100 text-pink-700', '/admin/subscribers', null],
  ];
  const total = byType.reduce((n, t) => n + t.count, 0) || 1;
  let acc = 0;
  const stops = byType.map((t) => { const from = acc; acc += (t.count / total) * 100; return `${t.color} ${from}% ${acc}%`; }).join(', ');
  const maxPage = Math.max(1, ...(traffic.pages.map((p) => p.count)));
%>
<section class="relative isolate overflow-hidden rounded-2xl bg-forest-900 p-6 text-white md:p-7">
  <img src="/images/hero.webp" alt="" class="absolute inset-0 -z-10 h-full w-full object-cover opacity-40">
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-forest-950/95 via-forest-950/70 to-forest-950/10"></div>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-gold"><%= today %></p>
      <h1 class="mt-1 !text-white md:!text-[1.6rem]">Welcome back, <%= user.name.split(' ')[0] %>!</h1>
      <p class="mt-1.5 max-w-xl text-sm text-white/80">
        <% if (stats.newInquiries) { %>You have <strong class="text-gold"><%= stats.newInquiries %> new inquir<%= stats.newInquiries === 1 ? 'y' : 'ies' %></strong> waiting for a reply.<% } else { %>All quote requests are answered. Nice work.<% } %>
        <% if (stats.pipeline) { %> Open pipeline: <strong class="text-gold"><%= money(stats.pipeline) %></strong>.<% } %>
      </p>
    </div>
    <div class="flex gap-2"><a href="/admin/inquiries?status=new" class="a-btn-primary">Open inbox</a><a href="/" target="_blank" rel="noopener" class="a-btn border border-white/30 text-white hover:bg-white/10">View website</a></div>
  </div>
</section>

<div class="mt-5" data-live="/admin/live/panel" data-interval="8000"><%- include('partials/live-panel', { live: live }) %></div>

<section class="mt-5 grid grid-cols-2 gap-3 lg:grid-cols-3 2xl:grid-cols-6">
  <% cards.forEach(function (c) { %>
    <a href="<%= c[4] %>" class="a-card group flex items-center gap-3.5 p-4 transition hover:-translate-y-0.5 hover:shadow-md">
      <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl <%= c[3] %>"><%- include('partials/icon', { n: c[2], s: 22 }) %></span>
      <span class="min-w-0"><span class="block truncate text-xs text-ink/55"><%= c[0] %></span><span class="block text-[1.4rem] font-bold leading-tight text-ink"><%= c[1] %></span>
        <% if (c[5] !== null) { %><span class="text-[11px] font-semibold <%= c[5] >= 0 ? 'text-green-700' : 'text-red-700' %>"><%= arrow(c[5]) %> <span class="font-normal text-ink/40">vs prior 30 days</span></span><% } %></span>
    </a>
  <% }) %>
</section>

<div class="mt-5 grid gap-5 xl:grid-cols-3">
  <section class="a-card p-5 xl:col-span-2">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <div><h2>Website traffic</h2><p class="text-xs text-ink/50">Last 30 days &middot; first-party, no cookies</p></div>
      <div class="flex items-center gap-4 text-xs"><span class="flex items-center gap-1.5"><i class="h-2.5 w-2.5 rounded-full bg-forest-500"></i>Page views</span><span class="flex items-center gap-1.5"><i class="h-2.5 w-2.5 rounded-full bg-gold"></i>Visitors</span><a class="font-semibold text-forest-500 hover:underline" href="/admin/analytics">Details &rarr;</a></div>
    </div>
    <%- include('partials/line-chart', { series: traffic.series }) %>
    <% if (!stats.views) { %><p class="mt-3 rounded-lg bg-mist/60 px-3 py-2 text-xs text-ink/60">No visits recorded yet. Open the public website in another tab and this chart starts filling in.</p><% } %>
  </section>

  <section class="a-card p-5">
    <h2 class="mb-3">Quick actions</h2>
    <div class="grid grid-cols-3 gap-2.5 text-center text-[11px] font-semibold">
      <% [['/admin/tours/new', 'plus', 'New tour'], ['/admin/blog/new', 'edit', 'New post'], ['/admin/bookings/new', 'calendar', 'New booking'], ['/admin/media', 'upload', 'Upload'], ['/admin/redirects/new', 'link', 'Redirect'], ['/admin/faqs/new', 'help', 'New FAQ'], ['/admin/seo', 'globe', 'SEO check'], ['/admin/settings', 'settings', 'Settings'], ['/admin/backup', 'database', 'Backup']].forEach(function (a) { %>
        <a href="<%= a[0] %>" class="flex flex-col items-center gap-1.5 rounded-xl border border-ink/10 px-1 py-3 text-ink transition hover:border-forest-500 hover:bg-mist/50"><span class="text-forest-500"><%- include('partials/icon', { n: a[1], s: 21 }) %></span><%= a[2] %></a>
      <% }) %>
    </div>
    <p class="mt-3 text-center text-[11px] text-ink/40">Press <kbd class="rounded border border-ink/15 px-1">Ctrl</kbd> + <kbd class="rounded border border-ink/15 px-1">K</kbd> to jump anywhere</p>
  </section>

  <section class="a-card p-5 xl:col-span-2">
    <div class="mb-3 flex items-center justify-between"><h2>Recent bookings</h2><a class="text-sm font-semibold text-forest-500 hover:underline" href="/admin/bookings">View all &rarr;</a></div>
    <div class="overflow-x-auto"><table class="a-table w-full min-w-[520px]">
      <thead><tr><th>Ref</th><th>Customer</th><th>Tour</th><th>Travel</th><th>Status</th><th class="!text-right">Amount</th></tr></thead>
      <tbody>
        <% recentBookings.forEach(function (b) { %>
          <tr><td><a class="font-semibold hover:text-forest-500" href="/admin/bookings/<%= b.ref %>/edit"><%= b.ref %></a></td><td><%= b.customerName %></td><td class="max-w-[180px] truncate"><%= b.tour || '-' %></td><td><%= b.travelDate ? short(b.travelDate) : '-' %></td>
          <td><span class="<%= ST[b.status] || 'a-badge-gray' %>"><%= b.status %></span></td><td class="text-right font-semibold"><%= money(b.total) %></td></tr>
        <% }) %>
        <% if (!recentBookings.length) { %><tr><td colspan="6" class="py-8 text-center text-ink/50">No bookings yet. Turn an inquiry into a booking from its detail page.</td></tr><% } %>
      </tbody>
    </table></div>
    <% if (stats.outstanding) { %><p class="mt-3 text-xs text-ink/55">Outstanding balance across active bookings: <strong class="text-ink"><%= money(stats.outstanding) %></strong></p><% } %>
  </section>

  <section class="a-card p-5">
    <h2 class="mb-3">Upcoming departures</h2>
    <ul class="space-y-2.5 text-sm">
      <% upcoming.forEach(function (b) { const d = new Date(b.travelDate); %>
        <li class="flex items-center gap-3"><span class="flex h-11 w-11 shrink-0 flex-col items-center justify-center rounded-lg bg-mist text-forest-700"><b class="text-sm leading-none"><%= d.getDate() %></b><i class="text-[10px] not-italic uppercase"><%= d.toLocaleDateString('en-GB', { month: 'short' }) %></i></span>
          <a class="min-w-0 flex-1" href="/admin/bookings/<%= b.ref %>/edit"><span class="block truncate font-semibold hover:text-forest-500"><%= b.customerName %></span><span class="block truncate text-xs text-ink/50"><%= b.tour || 'Custom tour' %> &middot; <%= b.travellers %> pax</span></a>
          <span class="<%= ST[b.status] || 'a-badge-gray' %>"><%= b.status %></span></li>
      <% }) %>
      <% if (!upcoming.length) { %><li class="py-6 text-center text-ink/50">No upcoming departures.</li><% } %>
    </ul>
  </section>

  <section class="a-card p-5 xl:col-span-2">
    <div class="mb-3 flex items-center justify-between"><h2>Latest inquiries</h2><a class="text-sm font-semibold text-forest-500 hover:underline" href="/admin/inquiries">View all &rarr;</a></div>
    <div class="overflow-x-auto"><table class="a-table w-full min-w-[520px]">
      <thead><tr><th>Name</th><th>Tour</th><th>Date</th><th>Status</th></tr></thead>
      <tbody>
        <% recentInquiries.forEach(function (i) { %>
          <tr><td><a class="font-semibold hover:text-forest-500" href="/admin/inquiries/<%= i.id %>"><%= i.name %></a><span class="block text-xs text-ink/50"><%= i.email %></span></td>
          <td class="max-w-[220px] truncate"><%= i.tour || 'General inquiry' %></td><td><%= short(i.createdAt) %></td>
          <td><span class="<%= ST[i.status] || 'a-badge-gray' %>"><%= i.status %></span></td></tr>
        <% }) %>
        <% if (!recentInquiries.length) { %><tr><td colspan="4" class="py-8 text-center text-ink/50">No quote requests yet. They appear here as soon as someone uses the website form.</td></tr><% } %>
      </tbody>
    </table></div>
  </section>

  <section class="a-card p-5">
    <h2 class="mb-3">Top pages</h2>
    <ul class="space-y-2.5 text-sm">
      <% traffic.pages.slice(0, 6).forEach(function (p) { %>
        <li><div class="flex justify-between gap-2"><span class="truncate font-medium"><%= p.name %></span><span class="font-semibold"><%= p.count %></span></div><div class="mt-1 h-1.5 rounded-full bg-mist"><div class="h-1.5 rounded-full bg-forest-500" style="width: <%= Math.round((p.count / maxPage) * 100) %>%"></div></div></li>
      <% }) %>
      <% if (!traffic.pages.length) { %><li class="py-6 text-center text-ink/50">Waiting for the first visits.</li><% } %>
    </ul>
  </section>

  <section class="a-card p-5">
    <h2>Content overview</h2>
    <div class="mt-4 flex items-center gap-5">
      <div class="relative h-32 w-32 shrink-0 rounded-full" style="background: conic-gradient(<%= stops %>)"><div class="absolute inset-4 flex flex-col items-center justify-center rounded-full bg-white"><strong class="text-xl"><%= byType.reduce((n, t) => n + t.count, 0) %></strong><span class="text-[10px] text-ink/50">Total items</span></div></div>
      <ul class="flex-1 space-y-1.5 text-xs">
        <% byType.forEach(function (t) { %><li class="flex items-center justify-between gap-2"><span class="flex items-center gap-2"><i class="h-2.5 w-2.5 rounded-full" style="background:<%= t.color %>"></i><%= t.label %></span><strong><%= t.count %></strong></li><% }) %>
      </ul>
    </div>
  </section>

  <section class="a-card p-5">
    <h2 class="mb-3">Site health</h2>
    <ul class="space-y-2 text-sm">
      <% health.forEach(function (h) { %>
        <li><a href="<%= h.href %>" class="flex items-start gap-2.5 rounded-lg p-1.5 hover:bg-mist/50">
          <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full <%= h.ok ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700' %>"><%- include('partials/icon', { n: h.ok ? 'check' : 'alert', s: 12 }) %></span>
          <span><span class="block font-medium leading-tight"><%= h.label %></span><% if (!h.ok) { %><span class="text-xs text-ink/50"><%= h.hint %></span><% } %></span></a></li>
      <% }) %>
    </ul>
  </section>

  <section class="a-card p-5">
    <h2 class="mb-3">Recent activity</h2>
    <ul class="space-y-3 text-sm">
      <% activity.forEach(function (a) { %>
        <li class="flex gap-2.5"><span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-forest-400"></span><span class="min-w-0"><span class="block truncate"><strong class="capitalize"><%= a.action %></strong> <%= a.title || a.key %></span><span class="text-xs text-ink/45"><%= a.user %> &middot; <%= new Date(a.at).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></span></span></li>
      <% }) %>
      <% if (!activity.length) { %><li class="py-6 text-center text-ink/50">No edits yet.</li><% } %>
    </ul>
  </section>

  <section class="a-card p-5">
    <div class="mb-3 flex items-center justify-between"><h2>Drafts needing review</h2></div>
    <ul class="divide-y divide-ink/5 text-sm">
      <% drafts.forEach(function (d) { %><li class="flex items-center justify-between gap-3 py-2.5"><a class="min-w-0 truncate font-medium hover:text-forest-500" href="<%= d.href %>"><%= d.title %></a><span class="a-badge-amber shrink-0"><%= d.type %></span></li><% }) %>
      <% if (!drafts.length) { %><li class="py-6 text-center text-ink/50">No drafts. Everything is published.</li><% } %>
    </ul>
  </section>

  <section class="a-card p-5">
    <div class="mb-3 flex items-center justify-between"><h2>Most requested tours</h2></div>
    <ol class="space-y-2.5 text-sm">
      <% topTours.forEach(function (t, i) { %><li class="flex items-center gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-mist text-xs font-bold text-forest-600"><%= i + 1 %></span><span class="min-w-0 flex-1 truncate"><%= t[0] %></span><strong><%= t[1] %></strong></li><% }) %>
      <% if (!topTours.length) { %><li class="py-6 text-center text-ink/50">Appears once guests request quotes.</li><% } %>
    </ol>
  </section>

  <section class="a-card p-5 xl:col-span-3">
    <div class="mb-3 flex items-center justify-between"><h2>Latest media</h2><a class="text-sm font-semibold text-forest-500 hover:underline" href="/admin/media">Open library &rarr;</a></div>
    <div class="grid grid-cols-3 gap-2.5 sm:grid-cols-6">
      <% (latestMedia.length ? latestMedia.map((m) => m.url) : ['/images/gallery/glad-9840.webp', '/images/gallery/cheetah.webp', '/images/destinations/serengeti-national-park.webp', '/images/destinations/ngorongoro-crater.webp', '/images/gallery/glad-9873.webp', '/images/destinations/tarangire-national-park.webp']).forEach(function (u) { %>
        <div class="media-box aspect-[4/3] rounded-lg"><img src="<%= u %>" alt="" loading="lazy"></div>
      <% }) %>
    </div>
    <% if (!latestMedia.length) { %><p class="mt-3 text-xs text-ink/55">No uploads yet. <a class="font-semibold text-forest-500 underline" href="/admin/media">Upload your first photo</a>.</p><% } %>
  </section>
</div>
