<%
  const arrow = (n) => (n > 0 ? '▲ ' + n + '%' : n < 0 ? '▼ ' + Math.abs(n) + '%' : '– 0%');
  const pct = (now, before) => (before ? Math.round(((now - before) / before) * 100) : null);
  const maxPage = Math.max(1, ...data.pages.map((p) => p.count));
  const devTotal = data.devices.reduce((n, d) => n + d.count, 0) || 1;
  const refTotal = Math.max(1, ...data.refs.map((r) => r.count));
%>
<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
  <div><nav class="mb-1 text-[13px] text-ink/50"><a class="hover:text-forest-500" href="/admin">Dashboard</a> / Analytics</nav><h1>Analytics</h1>
    <p class="text-sm text-ink/55">Your own privacy-friendly counters: no cookies, no personal data. Connect Google Analytics in Site Settings for deeper reports.</p></div>
  <nav class="flex gap-1 rounded-lg bg-white p-1 text-sm font-semibold ring-1 ring-black/5">
    <% [7, 30, 90].forEach(function (d) { %><a href="/admin/analytics?days=<%= d %>" class="rounded-md px-4 py-1.5 <%= days === d ? 'bg-forest-500 text-white' : 'hover:bg-mist' %>"><%= d %> days</a><% }) %>
  </nav>
</div>

<section class="grid grid-cols-2 gap-3 lg:grid-cols-4">
  <% [['Page views', data.views, pct(data.views, data.prevViews)], ['Visitors', data.visitors, pct(data.visitors, data.prevVisitors)], ['Views per visitor', data.visitors ? (data.views / data.visitors).toFixed(1) : '0.0', null], ['Today', data.today.views + ' views', null]].forEach(function (c) { %>
    <div class="a-card p-4"><p class="text-xs text-ink/55"><%= c[0] %></p><p class="text-2xl font-bold"><%= c[1] %></p>
      <% if (c[2] !== null) { %><p class="text-[11px] font-semibold <%= c[2] >= 0 ? 'text-green-700' : 'text-red-700' %>"><%= arrow(c[2]) %> <span class="font-normal text-ink/40">vs previous <%= days %> days</span></p><% } %></div>
  <% }) %>
</section>

<section class="a-card mt-5 p-5">
  <div class="mb-3 flex items-center justify-between"><h2>Traffic over time</h2><div class="flex gap-4 text-xs"><span class="flex items-center gap-1.5"><i class="h-2.5 w-2.5 rounded-full bg-forest-500"></i>Page views</span><span class="flex items-center gap-1.5"><i class="h-2.5 w-2.5 rounded-full bg-gold"></i>Visitors</span></div></div>
  <%- include('partials/line-chart', { series: data.series, height: 240 }) %>
</section>

<div class="mt-5 grid gap-5 lg:grid-cols-3">
  <section class="a-card p-5 lg:col-span-2">
    <h2 class="mb-3">Most viewed pages</h2>
    <ul class="space-y-3 text-sm">
      <% data.pages.forEach(function (p) { %><li><div class="flex justify-between gap-3"><a class="truncate font-medium hover:text-forest-500" href="<%= p.name %>" target="_blank" rel="noopener"><%= p.name %></a><span class="font-semibold"><%= p.count %></span></div><div class="mt-1 h-1.5 rounded-full bg-mist"><div class="h-1.5 rounded-full bg-forest-500" style="width: <%= Math.round((p.count / maxPage) * 100) %>%"></div></div></li><% }) %>
      <% if (!data.pages.length) { %><li class="py-8 text-center text-ink/50">No page views recorded yet.</li><% } %>
    </ul>
  </section>
  <div class="space-y-5">
    <section class="a-card p-5"><h2 class="mb-3">Devices</h2>
      <% data.devices.forEach(function (d) { %><div class="mb-2.5 text-sm"><div class="flex justify-between"><span class="capitalize"><%= d.name %></span><strong><%= Math.round((d.count / devTotal) * 100) %>%</strong></div><div class="mt-1 h-1.5 rounded-full bg-mist"><div class="h-1.5 rounded-full bg-gold" style="width: <%= Math.round((d.count / devTotal) * 100) %>%"></div></div></div><% }) %>
      <% if (!data.devices.length) { %><p class="py-4 text-center text-sm text-ink/50">No data yet.</p><% } %></section>
    <section class="a-card p-5"><h2 class="mb-3">Traffic sources</h2>
      <ul class="space-y-2 text-sm"><% data.refs.forEach(function (r) { %><li class="flex justify-between gap-2"><span class="truncate"><%= r.name %></span><strong><%= r.count %></strong></li><% }) %>
      <% if (!data.refs.length) { %><li class="py-4 text-center text-ink/50">Mostly direct visits so far.</li><% } %></ul></section>
  </div>
</div>

<section class="mt-5 grid grid-cols-2 gap-3 lg:grid-cols-4">
  <% [['Quote requests', conversions.enquiries, 'in the last ' + days + ' days'], ['Visitors who asked for a quote', conversions.rate + '%', 'quote requests ÷ visitors'], ['Bookings', conversions.bookings, 'not cancelled'], ['Contact button clicks', conversions.contactClicks, 'WhatsApp, phone, e-mail']].forEach(function (c) { %>
    <div class="a-card p-4"><p class="text-xs text-ink/55"><%= c[0] %></p><p class="text-2xl font-bold"><%= c[1] %></p><p class="text-[11px] text-ink/40"><%= c[2] %></p></div>
  <% }) %>
</section>

<div class="mt-5 grid gap-5 lg:grid-cols-3">
  <section class="a-card p-5"><h2 class="mb-3">Where visitors come from</h2>
    <ul class="space-y-2 text-sm"><% data.sources.forEach(function (r) { %><li class="flex justify-between gap-2"><span><%= r.name %></span><strong><%= r.count %></strong></li><% }) %>
    <% if (!data.sources.length) { %><li class="py-4 text-center text-ink/50">No visits recorded yet.</li><% } %></ul>
    <% if (data.search.length) { %><h3 class="mb-2 mt-4 text-xs font-bold uppercase tracking-wide text-ink/50">Search engines</h3>
    <ul class="space-y-1.5 text-sm"><% data.search.forEach(function (r) { %><li class="flex justify-between gap-2"><span class="capitalize"><%= r.name %></span><strong><%= r.count %></strong></li><% }) %></ul><% } %>
    <% if (data.campaigns.length) { %><h3 class="mb-2 mt-4 text-xs font-bold uppercase tracking-wide text-ink/50">Campaign links (utm)</h3>
    <ul class="space-y-1.5 text-sm"><% data.campaigns.forEach(function (r) { %><li class="flex justify-between gap-2"><span class="truncate"><%= r.name %></span><strong><%= r.count %></strong></li><% }) %></ul><% } %></section>
  <section class="a-card p-5"><h2 class="mb-3">Contact buttons clicked</h2>
    <ul class="space-y-2 text-sm"><% data.events.forEach(function (r) { %><li class="flex justify-between gap-2"><span class="capitalize"><%= r.name.replace('-', ' ') %></span><strong><%= r.count %></strong></li><% }) %>
    <% if (!data.events.length) { %><li class="py-4 text-center text-ink/50">No clicks recorded yet.</li><% } %></ul>
    <% if (conversions.topTours.length) { %><h3 class="mb-2 mt-4 text-xs font-bold uppercase tracking-wide text-ink/50">Safaris people asked about</h3>
    <ul class="space-y-1.5 text-sm"><% conversions.topTours.forEach(function (r) { %><li class="flex justify-between gap-2"><span class="truncate"><%= r.title %></span><strong><%= r.count %></strong></li><% }) %></ul><% } %></section>
  <section class="a-card p-5"><h2 class="mb-3">Search engine visits (crawlers)</h2>
    <p class="mb-2 text-xs text-ink/50">How often Google, Bing and others read your pages. They are not counted as visitors.</p>
    <ul class="space-y-2 text-sm"><% data.bots.slice(0, 8).forEach(function (r) { %><li class="flex justify-between gap-2"><span class="capitalize"><%= r.name %></span><strong><%= r.count %></strong></li><% }) %>
    <% if (!data.bots.length) { %><li class="py-4 text-center text-ink/50">No crawler visits recorded yet.</li><% } %></ul></section>
</div>

<div class="mt-5 grid gap-5 lg:grid-cols-3">
  <% [['Most viewed safaris', content.tours], ['Most read articles', content.blog], ['Most viewed destinations', content.destinations]].forEach(function (g) { %>
    <section class="a-card p-5"><h2 class="mb-3"><%= g[0] %></h2>
      <ul class="space-y-2 text-sm"><% g[1].forEach(function (r) { %><li class="flex justify-between gap-3"><span class="truncate capitalize"><%= r.title %></span><strong><%= r.count %></strong></li><% }) %>
      <% if (!g[1].length) { %><li class="py-4 text-center text-ink/50">No views yet.</li><% } %></ul></section>
  <% }) %>
</div>

<section id="countries" class="a-card mt-5 p-5">
  <div class="mb-3 flex flex-wrap items-center justify-between gap-2"><div><h2>Which countries bring clients</h2><p class="text-xs text-ink/50">Country of the visitor's connection (no addresses are stored with quote requests). The last <%= days %> days.</p></div><a class="a-btn-ghost" href="/admin/offers">Offers by country</a></div>
  <div class="grid gap-6 md:grid-cols-2">
    <div><h3 class="mb-2 text-xs font-bold uppercase tracking-wide text-ink/50">Visitors (page views)</h3>
      <ul class="space-y-2 text-sm"><% countries.visitors.forEach(function (c) { var req = (countries.requests.find(function (r) { return r.name === c.name; }) || {}).count || 0; %><li><div class="flex justify-between gap-3"><span><%= c.name %></span><span><strong><%= c.count %></strong><% if (req) { %> <span class="text-forest-500">&middot; <%= req %> request<%= req === 1 ? '' : 's' %></span><% } %></span></div><div class="mt-1 h-1.5 rounded-full bg-mist"><div class="h-1.5 rounded-full bg-forest-500" style="width: <%= Math.round((c.count / Math.max(1, countries.viewTotal)) * 100) %>%"></div></div></li><% }) %>
      <% if (!countries.visitors.length) { %><li class="py-4 text-center text-ink/50">No visits recorded yet.</li><% } %></ul></div>
    <div><h3 class="mb-2 text-xs font-bold uppercase tracking-wide text-ink/50">Quote requests (clients)</h3>
      <ul class="space-y-2 text-sm"><% countries.requests.forEach(function (c) { %><li class="flex justify-between gap-3"><span><%= c.name %></span><strong><%= c.count %></strong></li><% }) %>
      <% if (!countries.requests.length) { %><li class="py-4 text-center text-ink/50">No quote requests in this period. Requests from now on record the country.</li><% } %></ul></div>
  </div>
</section>

<section id="broken" class="a-card mt-5 p-5">
  <div class="mb-3 flex flex-wrap items-center justify-between gap-2"><div><h2>Broken links (404s)</h2><p class="text-xs text-ink/50">Addresses visitors or Google tried that do not exist. Fix them with a redirect.</p></div><a class="a-btn-ghost" href="/admin/redirects">All redirects</a></div>
  <div class="overflow-x-auto"><table class="a-table w-full min-w-[520px]">
    <thead><tr><th>Address</th><th class="!text-right">Times</th><th>Last seen</th><th class="!text-right">Action</th></tr></thead>
    <tbody>
      <% broken.forEach(function (b) { %>
        <tr><td class="max-w-[360px] truncate font-mono text-[13px]"><%= b.path %></td><td class="text-right font-semibold"><%= b.count %></td><td class="text-xs"><%= new Date(b.last || b.first).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) %></td>
          <td class="text-right"><div class="flex justify-end gap-1"><a class="a-btn-primary !px-3 !py-1.5" href="/admin/redirects/new?from=<%= encodeURIComponent(b.path) %>">Create redirect</a>
          <form method="post" action="/admin/analytics/404/dismiss"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="path" value="<%= b.path %>"><button class="a-btn-ghost !px-3 !py-1.5">Ignore</button></form></div></td></tr>
      <% }) %>
      <% if (!broken.length) { %><tr><td colspan="4" class="py-10 text-center text-ink/50">No unhandled broken links. 🎉</td></tr><% } %>
    </tbody>
  </table></div>
</section>
