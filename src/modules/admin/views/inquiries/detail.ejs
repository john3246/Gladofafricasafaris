<%
  const ST = { new: 'a-badge-blue', 'in-progress': 'a-badge-amber', replied: 'a-badge-green', booked: 'a-badge-green', closed: 'a-badge-gray' };
  const digits = String(item.phone || '').replace(/[^\d]/g, '');
  const first = item.name.split(' ')[0];
  const templates = Object.fromEntries(replies.map(function (r) { return [r.key, { subject: r.subject, body: r.body }]; }));
%>
<nav class="mb-1 text-[13px] text-ink/50"><a class="hover:text-forest-500" href="/admin">Dashboard</a> / <a class="hover:text-forest-500" href="/admin/inquiries">Inquiries</a> / <%= item.name %></nav>
<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
  <h1 class="flex flex-wrap items-center gap-3"><%= item.name %> <span class="<%= ST[item.status] || 'a-badge-gray' %>"><%= item.status %></span></h1>
  <div class="flex gap-2">
    <% if (linked.length) { %><a class="a-btn-ghost" href="/admin/bookings/<%= linked[0].ref %>/edit"><%- include('../partials/icon', { n: 'calendar', s: 16 }) %> Booking <%= linked[0].ref %></a>
    <% } else { %><a class="a-btn-primary" href="/admin/bookings/new?inquiry=<%= item.id %>"><%- include('../partials/icon', { n: 'calendar', s: 16 }) %> Create booking</a><% } %>
  </div>
</div>

<div class="grid items-start gap-6 xl:grid-cols-[minmax(0,1fr)_340px]">
  <div class="space-y-6">
    <section class="a-card p-6">
      <h2 class="mb-4">Request</h2>
      <dl class="grid gap-x-8 gap-y-4 text-sm sm:grid-cols-2">
        <div><dt class="text-ink/50">Email</dt><dd class="font-semibold"><a class="text-forest-500 hover:underline" href="mailto:<%= item.email %>"><%= item.email %></a></dd></div>
        <div><dt class="text-ink/50">Phone</dt><dd class="font-semibold"><%= item.phone || '-' %></dd></div>
        <div><dt class="text-ink/50">Country</dt><dd class="font-semibold"><%= item.country || 'Not known' %><%= item.lang && item.lang !== 'en' ? ' · wrote in ' + item.lang.toUpperCase() : '' %><%= item.referrer ? ' · came from ' + item.referrer : '' %></dd></div>
        <div><dt class="text-ink/50">Tour of interest</dt><dd class="font-semibold"><% if (item.tourSlug) { %><a class="text-forest-500 hover:underline" target="_blank" rel="noopener" href="/tours/<%= item.tourSlug %>"><%= item.tour %></a><% } else { %><%= item.tour || 'General inquiry' %><% } %></dd></div>
        <div><dt class="text-ink/50">Travel dates</dt><dd class="font-semibold"><%= ctx.dates %></dd></div>
        <div><dt class="text-ink/50">Travellers</dt><dd class="font-semibold"><%= item.adults || item.travellers %> adult<%= (item.adults || item.travellers) > 1 ? 's' : '' %><%= item.children ? ', ' + item.children + ' child' + (item.children > 1 ? 'ren' : '') : '' %></dd></div>
        <div><dt class="text-ink/50">Tour length</dt><dd class="font-semibold"><%= ctx.duration || '-' %></dd></div>
        <div class="sm:col-span-2"><dt class="text-ink/50">Safari styles</dt><dd class="mt-1 flex flex-wrap gap-1.5"><% (item.styles && item.styles.length ? item.styles : [item.tier || 'not-sure']).forEach(function (st) { %><span class="a-badge-blue"><%= st %></span><% }) %></dd></div>
        <div class="sm:col-span-2"><dt class="text-ink/50">Received</dt><dd class="font-semibold"><%= new Date(item.createdAt).toLocaleString('en-GB', { dateStyle: 'full', timeStyle: 'short' }) %></dd></div>
      </dl>
      <h3 class="mb-2 mt-6">Message</h3>
      <p class="whitespace-pre-line rounded-xl bg-mist/50 p-4 text-sm leading-relaxed"><%= item.message || '(no message)' %></p>
      <div class="mt-5 flex flex-wrap gap-2">
        <a class="a-btn-ghost" href="mailto:<%= item.email %>?subject=<%= encodeURIComponent('Your Tanzania safari quote - Glad Of Africa') %>"><%- include('../partials/icon', { n: 'mail', s: 16 }) %> Open in mail app</a>
        <% if (digits) { %><a class="a-btn-ghost" target="_blank" rel="noopener" href="https://wa.me/<%= digits %>?text=<%= encodeURIComponent('Hello ' + first + ', this is Glad Of Africa Safari & Tours about your safari request.') %>">WhatsApp</a><% } %>
      </div>
    </section>

    <section class="a-card p-6">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
        <h2>Reply by email</h2>
        <% if (!mailOk) { %><span class="a-badge-amber">E-mail sending not set up (SMTP_URL)</span><% } %>
      </div>
      <div class="mb-3 flex flex-wrap gap-2 text-xs">
        <span class="py-1.5 font-semibold text-ink/50">Quick templates:</span>
        <% replies.forEach(function (t) { %>
          <button type="button" class="rounded-full border border-ink/15 px-3 py-1.5 font-semibold hover:bg-mist" data-template="<%= t.key %>"><%= t.name %></button>
        <% }) %>
        <a class="px-2 py-1.5 font-semibold text-forest-500 underline" href="/admin/email-templates">Edit templates</a>
      </div>
      <form method="post" action="/admin/inquiries/<%= item.id %>/reply" class="space-y-3">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div><label class="a-label" for="subject">To: <%= item.email %> &middot; Subject</label><input class="input" id="subject" name="subject" required></div>
        <div><label class="a-label" for="body">Message</label><textarea class="input" id="body" name="body" rows="9" required></textarea></div>
        <button class="a-btn-primary" <%= mailOk ? '' : 'title="Needs SMTP_URL on the server"' %>><%- include('../partials/icon', { n: 'send', s: 16 }) %> Send email</button>
      </form>
      <script type="application/json" id="templates"><%- JSON.stringify(templates).replace(/</g, '\\u003c') %></script>
    </section>

    <section class="a-card p-6">
      <h2 class="mb-3">Internal notes</h2>
      <form method="post" action="/admin/inquiries/<%= item.id %>/note" class="flex gap-2"><input type="hidden" name="_csrf" value="<%= csrf %>">
        <input class="input" name="note" placeholder="Add a note for your team (not visible to the guest)..." required><button class="a-btn-primary">Add</button></form>
      <ul class="mt-4 space-y-3 text-sm">
        <% (item.notes || []).forEach(function (n) { %><li class="rounded-xl bg-mist/50 p-3.5"><p class="whitespace-pre-line"><%= n.text %></p><p class="mt-1.5 text-xs text-ink/50"><%= n.by %> &middot; <%= new Date(n.at).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) %></p></li><% }) %>
        <% if (!(item.notes || []).length) { %><li class="text-ink/50">No notes yet.</li><% } %>
      </ul>
    </section>
  </div>

  <aside class="space-y-5 xl:sticky xl:top-20">
    <section class="a-card p-5">
      <h2 class="mb-3">Status</h2>
      <form method="post" action="/admin/inquiries/<%= item.id %>/status" class="space-y-3"><input type="hidden" name="_csrf" value="<%= csrf %>">
        <select class="input" name="status"><% STATUSES.forEach(function (s) { %><option value="<%= s.value %>" <%= item.status === s.value ? 'selected' : '' %>><%= s.label %></option><% }) %></select>
        <button class="a-btn-primary w-full">Update status</button>
      </form>
    </section>
    <section class="a-card p-5">
      <h2 class="mb-3">Deal details</h2>
      <form method="post" action="/admin/inquiries/<%= item.id %>/details" class="space-y-3"><input type="hidden" name="_csrf" value="<%= csrf %>">
        <div><label class="a-label" for="value">Quote value (USD)</label><input class="input" id="value" name="value" type="number" min="0" step="10" value="<%= item.value || '' %>" placeholder="e.g. 7200"></div>
        <div><label class="a-label" for="assignee">Assigned to</label>
          <select class="input" id="assignee" name="assignee"><option value="">Unassigned</option><% team.forEach(function (t) { %><option value="<%= t.name %>" <%= item.assignee === t.name ? 'selected' : '' %>><%= t.name %></option><% }) %></select></div>
        <button class="a-btn-ghost w-full">Save details</button>
      </form>
    </section>
    <section class="a-card p-5">
      <form method="post" action="/admin/inquiries/<%= item.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="a-btn-danger w-full" data-confirm="Permanently delete this inquiry?"><%- include('../partials/icon', { n: 'trash', s: 16 }) %> Delete inquiry</button></form>
    </section>
  </aside>
</div>
