<%
  const ST = { new: 'a-badge-blue', 'in-progress': 'a-badge-amber', replied: 'a-badge-green', booked: 'a-badge-green', closed: 'a-badge-gray' };
%>
<div class="mb-5 flex flex-wrap items-center justify-between gap-3">
  <div><h1>Inquiries</h1><p class="text-sm text-ink/55">Quote requests from the website form. <%= total %> in total.</p></div>
  <a href="/admin/inquiries/export.csv" class="a-btn-ghost"><%- include('../partials/icon', { n: 'download', s: 16 }) %> Export CSV</a>
</div>

<nav class="mb-4 flex flex-wrap gap-2 text-sm font-semibold">
  <a href="/admin/inquiries" class="rounded-full px-4 py-1.5 <%= !status ? 'bg-forest-500 text-white' : 'bg-white ring-1 ring-black/5 hover:bg-mist' %>">All <span class="opacity-70"><%= total %></span></a>
  <% STATUSES.forEach(function (s) { %><a href="/admin/inquiries?status=<%= s.value %>" class="rounded-full px-4 py-1.5 <%= status === s.value ? 'bg-forest-500 text-white' : 'bg-white ring-1 ring-black/5 hover:bg-mist' %>"><%= s.label %> <span class="opacity-70"><%= counts[s.value] %></span></a><% }) %>
</nav>

<form class="a-card mb-4 flex gap-3 p-3" method="get"><input type="hidden" name="status" value="<%= status %>"><input class="input !py-2" name="q" value="<%= q %>" placeholder="Search name, email, tour, message..."><button class="a-btn-ghost">Search</button></form>

<div class="a-card overflow-x-auto">
  <table class="a-table w-full min-w-[720px]">
    <thead><tr><th>Guest</th><th>Tour / interest</th><th>Country</th><th>Travel</th><th>Received</th><th>Status</th></tr></thead>
    <tbody>
      <% items.forEach(function (i) { %>
        <tr>
          <td><a class="font-semibold hover:text-forest-500" href="/admin/inquiries/<%= i.id %>"><%= i.name %></a><span class="block text-xs text-ink/50"><%= i.email %><%= i.phone ? ' · ' + i.phone : '' %></span></td>
          <td class="max-w-[260px]"><span class="block truncate"><%= i.tour || 'General inquiry' %></span><span class="text-xs text-ink/50"><%= (i.styles && i.styles.length ? i.styles.slice(0, 2).join(', ') + (i.styles.length > 2 ? ' +' + (i.styles.length - 2) : '') : i.tier) %></span></td>
          <td class="text-xs"><%= i.country || '-' %></td>
          <td class="text-xs"><%= i.startDate ? i.startDate + (i.endDate ? ' → ' + i.endDate : '') : (i.travelMonth || '-') %><span class="block text-ink/50"><%= i.travellers %> traveller<%= i.travellers == 1 ? '' : 's' %></span></td>
          <td class="text-xs"><%= new Date(i.createdAt).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) %></td>
          <td><span class="<%= ST[i.status] || 'a-badge-gray' %>"><%= i.status %></span></td>
        </tr>
      <% }) %>
      <% if (!items.length) { %><tr><td colspan="5" class="py-10 text-center text-ink/50">No inquiries found.</td></tr><% } %>
    </tbody>
  </table>
</div>
