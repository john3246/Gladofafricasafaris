<div class="flex min-h-screen items-center justify-center bg-canvas p-6">
  <form method="post" action="/admin/reset/<%= token %>" class="a-card w-full max-w-sm p-8" novalidate>
    <img src="/images/logo-green.png" alt="Glad Of Africa" width="170" height="56" class="mb-6 h-12 w-auto">
    <h1>Choose a new password</h1>
    <p class="mt-1 text-sm text-ink/60">At least <%= min %> characters. This link works only once.</p>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label class="a-label mt-5" for="pass">New password</label>
    <input class="input" id="pass" name="pass" type="password" autocomplete="new-password" minlength="<%= min %>" required autofocus>
    <% if (errors.pass) { %><p class="a-err"><%= errors.pass %></p><% } %>
    <label class="a-label mt-4" for="confirm">Repeat the new password</label>
    <input class="input" id="confirm" name="confirm" type="password" autocomplete="new-password" required>
    <% if (errors.confirm) { %><p class="a-err"><%= errors.confirm %></p><% } %>
    <button class="a-btn-primary mt-6 w-full" type="submit">Save password</button>
    <p class="mt-4 text-center text-xs text-ink/50">Saving signs you out everywhere else.</p>
  </form>
</div>
