<%# GM tour-detail layout: centred hero, breadcrumb strip, white cards on a tinted band, sticky "At a glance" aside %>
<section class="on-dark relative isolate overflow-hidden bg-forest-950 text-center text-white">
  <% if (tour.image) { %><img src="<%= tour.image %>" alt="<%= tour.title %>" width="1600" height="700" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover opacity-55"><% } %>
  <div class="absolute inset-0 -z-10 bg-black/40"></div>
  <div class="container-site py-14 md:py-20">
    <p class="inline-block bg-white/90 px-3 py-1 font-mono text-[11px] font-bold uppercase tracking-[0.18em] text-ink"><%= tour.tier %> safari</p>
    <h1 class="mx-auto mt-4 max-w-4xl !text-white"><%= tour.title %></h1>
    <p class="mt-4 font-mono text-[12px] uppercase tracking-[0.15em] text-white/85"><%= nights(tour.days) %><% if (tour.destinations.length) { %> &middot; <%= route(tour.destinations) %><% } %></p>
    <p class="mt-4 font-serif text-2xl text-gold">From USD <%= tour.priceFrom.toLocaleString('en-US') %> per person</p>
    <a href="/book/<%= tour.slug %>" class="btn-dark mt-6 !bg-black">Book this safari</a>
  </div>
</section>
<%- include('partials/ai-summary', { text: summary }) %>

<nav aria-label="Breadcrumb" class="bg-white">
  <ol class="container-site flex flex-wrap gap-2 py-3 text-xs text-ink/65">
    <% breadcrumbs.forEach(function (b) { %>
      <li><% if (b.href) { %><a class="hover:text-forest-500 hover:underline" href="<%= b.href %>"><%= b.name %></a> <span aria-hidden="true">&rsaquo;</span><% } else { %><span aria-current="page"><%= b.name %></span><% } %></li>
    <% }) %>
  </ol>
</nav>

<div class="bg-sand py-8 md:py-10">
  <div class="container-site grid gap-6 lg:grid-cols-[minmax(0,1fr)_340px]">
    <div class="space-y-6">
      <%- include('partials/tour-overview') %>
      <%- include('partials/tour-gallery') %>
      <%- include('partials/tour-itinerary') %>
      <%- include('partials/tour-included') %>
      <%- include('partials/tour-faq') %>
    </div>
    <%- include('partials/tour-glance') %>
  </div>
</div>

<% if (related.length) { %>
<section class="bg-white py-12">
  <div class="container-site">
    <p class="eyebrow">Keep exploring</p>
    <h2 class="mt-2">Other Tanzania <em>itineraries</em></h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <% related.forEach(function (t) { %><%- include('partials/tour-card', { tour: t }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="on-dark bg-forest-600 py-10 text-center text-white">
  <div class="container-site">
    <h2 class="!text-3xl">Ready to travel this route?</h2>
    <p class="mt-2 text-white/85">From USD <%= tour.priceFrom.toLocaleString('en-US') %> per person. <%= tour.title %> with a local Arusha team.</p>
    <a href="/book/<%= tour.slug %>" class="btn-gold mt-5">Book this safari</a>
  </div>
</section>

<section class="bg-white py-8">
  <div class="container-site">
    <p class="eyebrow">More ways to plan this safari</p>
    <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm font-bold text-forest-500">
      <li><a class="hover:underline" href="/tanzania-safaris">Tanzania safari packages</a></li>
      <li><a class="hover:underline" href="/blog/tanzania-safari-cost">Tanzania safari cost</a></li>
      <li><a class="hover:underline" href="/blog/best-time-to-visit-tanzania-safari">Best time to visit Tanzania</a></li>
      <li><a class="hover:underline" href="/blog/great-migration-calendar-tanzania">Great Migration calendar</a></li>
    </ul>
  </div>
</section>
