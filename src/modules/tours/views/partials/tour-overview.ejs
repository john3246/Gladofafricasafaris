<section class="bg-white p-6 shadow-sm md:p-8">
  <p class="eyebrow">Overview</p>
  <h2 class="mt-1 !text-3xl">About this itinerary</h2>
  <div class="prose-site mt-4">
    <% tour.description.forEach(function (p) { %><p><%= p %></p><% }) %>
  </div>
  <% if (tour.highlights.length) { %>
    <p class="eyebrow mt-6">Highlights</p>
    <ul class="check-list mt-3 grid gap-2 text-[15px] sm:grid-cols-2">
      <% tour.highlights.forEach(function (h) { %><li><%= h %></li><% }) %>
    </ul>
  <% } %>
</section>
