<section class="bg-white p-6 shadow-sm md:p-8">
  <p class="eyebrow">Included / excluded</p>
  <h2 class="mt-1 !text-3xl">What's included</h2>
  <div class="mt-5 grid gap-8 sm:grid-cols-2">
    <ul class="check-list space-y-2 text-[15px]"><% tour.includes.forEach(function (x) { %><li><%= x %></li><% }) %></ul>
    <div>
      <h3 class="mb-3 !text-xl">Not included</h3>
      <ul class="cross-list space-y-2 text-[15px]"><% tour.excludes.forEach(function (x) { %><li><%= x %></li><% }) %></ul>
    </div>
  </div>
</section>
