<section class="section bg-white text-center">
  <div class="container-site max-w-xl">
    <% if (valid) { %>
      <p class="eyebrow">You're on the list</p>
      <h1 class="mt-2">Asante sana!</h1>
      <p class="mt-4">Thank you for subscribing. We'll send you safari tips, migration updates and special offers from our Arusha team.</p>
    <% } else { %>
      <p class="eyebrow">Almost there</p>
      <h1 class="mt-2">That email doesn't look right</h1>
      <p class="mt-4">Please go back and enter a valid email address.</p>
    <% } %>
    <a href="/" class="btn-primary mt-6">Back to home</a>
  </div>
</section>
