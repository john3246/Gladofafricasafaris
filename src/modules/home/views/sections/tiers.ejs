<section class="section bg-cream">
  <div class="container-site">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">Every budget, the same wild Serengeti</p>
      <h2 class="mt-2">Choose your Tanzania safari style</h2>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      <% [
        { href: '/tanzania-safaris/luxury', t: 'Luxury', d: 'Boutique camps, private bush flights and exclusive guiding.', p: 'From $5,200' },
        { href: '/tanzania-safaris/midrange', t: 'Midrange', d: 'Comfortable lodges, private 4x4 and a flexible itinerary.', p: 'From $1,350' },
        { href: '/tanzania-safaris/budget', t: 'Budget', d: 'Small-group and camping safaris with expert guides.', p: 'From $1,000' }
      ].forEach(function (x, i) { %>
        <a href="<%= x.href %>" class="card group p-7 <%= i === 1 ? 'ring-2 ring-gold' : '' %>">
          <h3 class="group-hover:text-forest-600"><%= x.t %> Safaris</h3>
          <p class="mt-2 text-sm text-forest-800/80"><%= x.d %></p>
          <p class="mt-5 font-serif text-xl font-semibold text-forest-600"><%= x.p %> pp &rarr;</p>
        </a>
      <% }) %>
    </div>
  </div>
</section>
