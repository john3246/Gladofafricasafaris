<section class="on-dark bg-forest-950 py-10 text-white sm:py-14">
  <div class="container-site">
    <p class="eyebrow">Safari experiences</p>
    <h2 class="mt-2">Four ways to <em>meet Tanzania</em></h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <% [
        { href: '/tanzania-safaris', tag: 'Safari experiences', t: 'Game Drives', d: 'Journey through Tanzania with elegant game drives, private walks, and timeless encounters.', i: 1 },
        { href: '/tanzania-safaris/migration', tag: 'Migration safaris', t: 'The Great Migration', d: "Follow two million wildebeest and zebra across the Serengeti's plains.", i: 2 },
        { href: '/tanzania-safaris/luxury', tag: 'Signature journeys', t: 'Tailored Adventures', d: 'Every itinerary we run is built to order, then tailored around you.', i: 3 },
        { href: '/tanzania-safaris/trekking', tag: 'Hiking & trekking', t: 'Kilimanjaro & Beyond', d: 'Summit Kilimanjaro or wind through the Crater Highlands.', i: 4 }
      ].forEach(function (x) { %>
        <a href="<%= x.href %>" class="group relative isolate block aspect-[3/4] overflow-hidden bg-forest-800">
          <img src="/images/experiences/<%= x.i %>.webp" alt="<%= x.t %>" width="600" height="800" loading="lazy" class="absolute inset-0 -z-10 h-full w-full object-cover transition duration-500 group-hover:scale-105">
          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/85 via-black/25 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-5">
            <p class="font-mono text-[10px] font-bold uppercase tracking-[0.18em] text-gold"><%= x.tag %></p>
            <h3 class="mt-1 !text-white"><%= x.t %></h3>
            <p class="mt-1 text-sm text-white/80"><%= x.d %></p>
            <p class="mt-3 font-mono text-[11px] font-bold uppercase tracking-wider text-white">View more &rarr;</p>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>
