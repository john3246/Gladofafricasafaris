<section class="bg-white py-10 sm:py-14 lg:py-16">
  <div class="container-site">
    <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
      <div>
        <p class="eyebrow">Bespoke Tanzania safaris</p>
        <h2 class="mt-2">Your perfect safari, <em>waiting to begin</em></h2>
      </div>
      <p class="leading-relaxed">Witness a million hooves thunder across the Mara, wake to sunrise over the Serengeti from a private airstrip, or stand above the clouds on Kilimanjaro's frozen summit. However you've dreamed of Africa, we've hand crafted the journey to match: trusted guides, iconic landscapes, and moments you'll tell stories about for a lifetime.</p>
    </div>
    <ul class="mt-6 flex flex-wrap gap-2 text-[12px] font-bold uppercase tracking-wider">
      <% nav.tourStyles.filter(function (s) { return !/Midrange/.test(s.label); }).forEach(function (s, i) { %>
        <li><a href="<%= s.href %>" class="inline-block rounded-full border px-4 py-2 <%= i === 2 ? 'border-forest-500 bg-forest-500 text-white' : 'border-ink/20 hover:bg-forest-900 hover:text-white' %>"><%= s.label.replace('Exclusive ', '') %></a></li>
      <% }) %>
    </ul>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <% bespoke.forEach(function (tour) { %><%- include('partials/tour-card', { tour: tour }) %><% }) %>
    </div>
    <p class="mt-8 text-center"><a href="/tanzania-safaris/migration" class="btn-dark">View All Migration Safaris</a></p>
  </div>
</section>
