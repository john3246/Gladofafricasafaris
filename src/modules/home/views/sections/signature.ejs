<section class="bg-cream py-10 sm:py-14 lg:py-16">
  <div class="container-site" data-carousel>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Signature Tanzania safaris</p>
        <h2 class="mt-2">Signature journeys, <em>crafted for unforgettable moments</em></h2>
        <p class="lede mt-2">Five exceptional itineraries. One extraordinary Tanzania.</p>
      </div>
      <div class="flex gap-2">
        <button data-prev class="flex h-11 w-11 items-center justify-center rounded-full border border-ink/20 hover:bg-forest-900 hover:text-white" aria-label="Previous">&larr;</button>
        <button data-next class="flex h-11 w-11 items-center justify-center rounded-full border border-ink/20 hover:bg-forest-900 hover:text-white" aria-label="Next">&rarr;</button>
      </div>
    </div>
    <div data-track class="scrollbar-none mt-8 flex snap-x snap-mandatory gap-5 overflow-x-auto pb-4">
      <% signature.forEach(function (tour) { %><%- include('partials/signature-card', { tour: tour }) %><% }) %>
    </div>
    <p class="mt-4 text-center"><a href="/tanzania-safaris" class="btn-primary">View All Packages</a></p>
  </div>
</section>
