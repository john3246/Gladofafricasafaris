<% if (zanzibar.length) { %>
<section class="bg-white py-10 sm:py-14">
  <div class="container-site">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Beach vacations</p>
        <h2 class="mt-2">Explore <em>Zanzibar Island</em></h2>
        <p class="mt-3 max-w-2xl text-ink/70">End your safari on the Indian Ocean: spice farms, the lanes of Stone Town and quiet beaches on Zanzibar.</p>
      </div>
      <a href="/destinations/stone-town" class="btn-dark">View Zanzibar</a>
    </div>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      <% zanzibar.forEach(function (tour) { %><%- include('partials/tour-card', { tour: tour }) %><% }) %>
    </div>
  </div>
</section>
<% } %>
