<%# GM-style inner-page hero. params: title, sub (optional), image (optional) ; uses breadcrumbs local %>
<section class="on-dark relative isolate overflow-hidden bg-forest-900 text-white">
  <% if (typeof image !== 'undefined' && image) { %><img src="<%= image %>" alt="" width="1600" height="500" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover opacity-45"><% } %>
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-forest-950/85 to-forest-950/30"></div>
  <div class="container-site py-12 md:py-16">
    <% if (breadcrumbs.length > 1) { %>
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 font-mono text-[11px] uppercase tracking-wider text-white/75">
        <% breadcrumbs.forEach(function (b, i) { %>
          <li><% if (b.href) { %><a class="hover:text-gold" href="<%= b.href %>"><%= b.name %></a> <span aria-hidden="true">&rsaquo;</span><% } else { %><span aria-current="page"><%= b.name %></span><% } %></li>
        <% }) %>
      </ol>
    </nav>
    <% } %>
    <h1 class="mt-3 max-w-3xl !text-white"><%- title %></h1>
    <% if (typeof sub !== 'undefined' && sub) { %><p class="mt-3 max-w-2xl text-lg text-white/85"><%= sub %></p><% } %>
  </div>
</section>
