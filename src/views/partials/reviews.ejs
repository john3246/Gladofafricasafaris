<%# Real Google reviews (src/data/reviews.data.js). Renders nothing when empty. %>
<% if (reviews && reviews.length) { %>
<section class="bg-sand py-12 sm:py-16">
  <div class="container-site">
    <p class="eyebrow">Guest reviews</p>
    <h2 class="mt-2">What our <em>travellers say</em></h2>
    <p class="mt-3 flex items-center gap-2 text-sm"><span class="text-gold" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span> Independent 5-star Google reviews</p>
    <div class="mt-8 gap-5 sm:columns-2 lg:columns-3">
      <% reviews.forEach(function (r) { %>
        <figure class="mb-5 break-inside-avoid border border-ink/10 bg-white p-6">
          <p class="text-gold" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</p>
          <blockquote class="mt-3 text-[15px] leading-relaxed">&ldquo;<%= r.text %>&rdquo;</blockquote>
          <figcaption class="mt-4 font-mono text-[11px] font-bold uppercase tracking-wider text-forest-900"><%= r.name %></figcaption>
        </figure>
      <% }) %>
    </div>
  </div>
</section>
<% } %>
