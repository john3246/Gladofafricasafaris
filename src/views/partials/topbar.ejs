<%# Top strip: contact details on the left; Reviews, Accommodations, other links and social icons on the right. %>
<% const social = [...site.social, { name: 'WhatsApp', url: site.whatsapp }].filter(function (s) { return s.url; }); %>
<div class="relative z-[70] bg-forest-900 text-[12px] font-medium text-white/90">
  <div class="container-site flex items-center justify-between gap-3 py-2">
    <div class="flex min-w-0 flex-wrap items-center gap-x-5 gap-y-1">
      <a href="tel:<%= site.phoneRaw %>" class="hover:text-gold">&#9990; <%= site.phone %></a>
      <a href="mailto:<%= site.email %>" class="hidden hover:text-gold sm:inline">&#9993; <%= site.email %></a>
    </div>
    <div class="flex shrink-0 items-center gap-5">
      <nav aria-label="Top links" class="hidden items-center gap-5 md:flex">
        <% nav.topLinks.forEach(function (l) { %><a href="<%= l.href %>" class="whitespace-nowrap hover:text-gold <%= currentPath === l.href ? 'text-gold' : '' %>"><%= l.label %></a><% }) %>
      </nav>
      <%- include('lang-switcher') %>
      <% if (social.length) { %><div class="flex items-center gap-1.5" aria-label="Follow us"><%- include('social-icons', { items: social }) %></div><% } %>
    </div>
  </div>
</div>
