<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= seo.title %></title>
<meta name="description" content="<%= seo.description %>">
<link rel="canonical" href="<%= canonical %>">
<link rel="alternate" type="text/plain" href="/llms.txt" title="Summary for AI assistants">
<link rel="alternate" type="application/rss+xml" title="<%= site.name %> blog" href="/blog/feed.xml">
<meta name="robots" content="<%= (seo.noindex || siteSettings.noindex) ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1' %>">
<meta name="theme-color" content="<%= site.themeColor %>">
<meta property="og:site_name" content="<%= site.name %>">
<meta property="og:type" content="<%= seo.type %>">
<meta property="og:title" content="<%= seo.title %>">
<meta property="og:description" content="<%= seo.description %>">
<meta property="og:url" content="<%= canonical %>">
<meta property="og:image" content="<%= seo.image %>">
<meta property="og:image:alt" content="<%= seo.title %>">
<meta property="og:locale" content="en_US">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= seo.title %>">
<meta name="twitter:description" content="<%= seo.description %>">
<meta name="twitter:image" content="<%= seo.image %>">
<meta name="author" content="<%= site.name %>">
<% alternates.forEach(function (a) { %><link rel="alternate" hreflang="<%= a.lang %>" href="<%= a.href %>">
<% }) %>
<% if (siteSettings.googleVerify) { %><meta name="google-site-verification" content="<%= siteSettings.googleVerify %>"><% } %>
<% if (siteSettings.bingVerify) { %><meta name="msvalidate.01" content="<%= siteSettings.bingVerify %>"><% } %>
<% if (seo.published) { %><meta property="article:published_time" content="<%= seo.published %>"><% } %>
<% if (seo.modified) { %><meta property="article:modified_time" content="<%= seo.modified %>"><% } %>
<link rel="icon" href="/icons/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=DM+Sans:wght@300;400;500;700&family=Space+Mono:wght@400;700&display=swap" media="print" data-async-font>
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=DM+Sans:wght@300;400;500;700&family=Space+Mono:wght@400;700&display=swap"></noscript>
<link rel="stylesheet" href="<%= asset('/css/app.css') %>">
<% if (siteSettings.gaId) { %>
<script src="/js/ga.js" defer data-id="<%= siteSettings.gaId %>"></script>
<% } %>
<% var hasOrg = schemas.some(function (s) { return JSON.stringify(s['@type']).indexOf('TravelAgency') > -1; }); %>
<% globalSchemas.filter(function (s) { return !(hasOrg && s['@type'] !== 'WebSite'); }).concat(schemas).forEach(function (s) { %>
<script type="application/ld+json"><%- JSON.stringify(s).replace(/</g, '\\u003c') %></script>
<% }) %>
