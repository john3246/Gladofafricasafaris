<div class="divide-y divide-ink/10 border border-ink/10 bg-white">
  <% faqs.forEach(function (f) { %>
    <details class="group p-5">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-serif text-lg font-bold text-forest-900">
        <%= f.q %><span class="text-2xl leading-none text-forest-500 transition group-open:rotate-45">+</span>
      </summary>
      <p class="mt-3 text-[15px] leading-relaxed"><%= f.a %></p>
    </details>
  <% }) %>
</div>
