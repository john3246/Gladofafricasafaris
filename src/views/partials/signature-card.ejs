<%# Glad "Signature Journeys" carousel card. params: tour %>
<article class="w-[78%] shrink-0 snap-start sm:w-[44%] lg:w-[23.5%]" data-slide>
  <a href="/tours/<%= tour.slug %>" class="group block overflow-hidden bg-white shadow-md ring-1 ring-black/5">
    <div class="media-box aspect-[4/3]">
      <img src="<%= tour.image %>" alt="<%= tour.title %>" width="640" height="480" loading="lazy" decoding="async" class="transition duration-500 group-hover:scale-105">
      <% if (tour.badge) { %><span class="absolute left-3 top-3 bg-forest-900/90 px-2.5 py-1 font-mono text-[9px] font-bold uppercase tracking-[0.15em] text-white"><%= tour.badge %></span><% } %>
    </div>
    <div class="p-5">
      <h3 class="font-serif text-lg font-semibold leading-snug text-forest-900"><%= tour.title %></h3>
      <p class="mt-3 flex items-baseline justify-between border-t border-ink/10 pt-3">
        <span><strong class="font-serif text-2xl text-forest-600"><%= usd(tour.priceFrom) %></strong> <span class="text-xs text-ink/60">/ person</span></span>
        <span class="font-mono text-[11px] uppercase tracking-wider text-ink/60"><%= tour.days %> Days</span>
      </p>
      <p class="mt-3 font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-forest-500 group-hover:underline">View Details &rarr;</p>
    </div>
  </a>
</article>
