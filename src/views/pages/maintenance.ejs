<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>We'll be right back | Glad Of Africa</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cormorant+Garamond:ital,wght@1,400&family=DM+Sans:wght@400;500&display=swap">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="flex min-h-screen items-center justify-center bg-forest-900 p-6 text-center text-white">
  <main>
    <img src="/images/logo-white.png" alt="Glad Of Africa" width="200" height="66" class="mx-auto h-16 w-auto">
    <h1 class="mt-8 font-display text-5xl uppercase tracking-wide !text-white md:text-7xl">We'll be right back</h1>
    <p class="mt-3 font-serif text-2xl italic text-gold">Our website is getting a little polish.</p>
    <p class="mx-auto mt-6 max-w-md text-white/80">Planning a safari? Reach our Arusha team directly and we will answer right away.</p>
    <p class="mt-5 flex flex-wrap justify-center gap-3 text-sm font-bold">
      <a class="rounded-full bg-gold px-5 py-2.5 text-forest-950" href="https://wa.me/<%= String(siteSettings.phone).replace(/[^\d]/g, '') %>">WhatsApp us</a>
      <a class="rounded-full border border-white/40 px-5 py-2.5" href="mailto:<%= siteSettings.email %>"><%= siteSettings.email %></a>
    </p>
  </main>
</body>
</html>
