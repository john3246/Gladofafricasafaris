<% const hs = siteSettings.hero || {}; const vid = b.useSiteHero ? (hs.video || '') : (b.video || ''); const img = vid ? (hs.poster || '/video/poster.webp') : ((b.useSiteHero ? hs.image : b.image) || '/images/hero.webp'); %>
<section class="on-dark relative isolate flex min-h-[560px] items-end overflow-hidden bg-forest-900 text-white md:min-h-[720px]">
  <img src="<%= img %>" alt="<%= b.useSiteHero ? ((hs.line1 || '') + ' ' + (hs.line2 || '')).trim() : String(b.heading || '').replace(/<[^>]+>/g, '') %>" width="1800" height="1000" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover">
  <% if (vid) { %><video class="absolute inset-0 -z-10 h-full w-full object-cover opacity-0 transition-opacity duration-700" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" disablepictureinpicture data-hero-video data-src="<%= vid %>" data-src-small="<%= (b.useSiteHero ? hs.videoSmall : '') || vid %>"></video><% } %>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/80 via-black/35 to-black/20"></div>
  <div class="container-site pb-16 pt-32 md:pb-24">
    <h1 class="!text-white">
      <% if (b.useSiteHero) { %>
        <span class="block font-display text-6xl font-normal uppercase tracking-[0.03em] md:text-[4.5rem]"><%= hs.line1 %></span>
        <span class="block font-serif text-4xl font-light italic md:text-6xl"><%= hs.line2 %></span>
      <% } else { %>
        <span class="block font-display text-5xl font-normal uppercase tracking-[0.03em] md:text-[4.5rem]"><%- b.headingHtml %></span>
      <% } %>
    </h1>
    <% const text = b.useSiteHero ? hs.text : b.intro; if (text) { %><p class="mt-5 max-w-xl text-[15.5px] leading-relaxed text-white/85"><%= text %></p><% } %>
    <%- include('_buttons', { b: b, cls: 'mt-8' }) %>
  </div>
</section>
