<% if (d.regions.length) { %>
<section class="<%= b.t.cls %> py-10 sm:py-14 lg:py-16">
  <div class="container-site">
    <% if (b.eyebrow || b.heading || b.intro) { %><div class="mx-auto max-w-3xl text-center">
      <% if (b.eyebrow) { %><p class="eyebrow"><%= b.eyebrow %></p><% } %>
      <% if (b.heading) { %><h2 class="mt-2"><%- b.headingHtml %></h2><% } %>
      <% if (b.intro) { %><p class="mt-3 <%= b.t.dark ? 'text-white/80' : 'text-ink/70' %>"><%= b.intro %></p><% } %>
    </div><% } %>
    <div class="mx-auto mt-8 grid max-w-6xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% d.regions.forEach(function (r) { %>
        <a href="/destinations#<%= r.slug %>" class="group relative isolate block aspect-[4/3] overflow-hidden bg-forest-900 text-white">
          <% if (r.image) { %><img src="<%= r.image %>" alt="<%= r.title %>" width="800" height="600" loading="lazy" class="absolute inset-0 -z-10 h-full w-full object-cover transition duration-500 group-hover:scale-105"><% } %>
          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/85 via-black/30 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-6">
            <p class="font-mono text-[11px] font-bold uppercase tracking-[0.18em] text-gold"><%= r.trips ? r.trips + ' tours' : 'Tailor-made tours' %></p>
            <h3 class="mt-1 !text-white"><%= r.title %></h3>
            <p class="mt-1 text-sm text-white/80"><%= r.text %></p>
          </div>
        </a>
      <% }) %>
    </div>
    <% if (b.buttons.length) { %><div class="mt-8 text-center"><%- include('_buttons', { b: b, cls: 'justify-center' }) %></div><% } %>
  </div>
</section>
<% } %>
