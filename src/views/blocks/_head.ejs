<%# Eyebrow, heading and intro shared by most sections. param: b. Buttons sit on the right. %>
<% if (b.eyebrow || b.heading || b.intro || b.buttons.length) { %>
<div class="flex flex-wrap items-end justify-between gap-4">
  <div class="max-w-3xl">
    <% if (b.eyebrow) { %><p class="eyebrow"><%= b.eyebrow %></p><% } %>
    <% if (b.heading) { %><h2 class="mt-2"><%- b.headingHtml %></h2><% } %>
    <% if (b.intro) { %><p class="mt-3 <%= b.t.dark ? 'text-white/80' : 'text-ink/70' %>"><%= b.intro %></p><% } %>
  </div>
  <%- include('_buttons', { b: b }) %>
</div>
<% } %>
