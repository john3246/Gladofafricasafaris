<% if (b.rows.length) { %>
<section class="<%= b.t.cls %> py-10 sm:py-14">
  <div class="container-site">
    <%- include('_head', { b: b }) %>
    <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% b.rows.forEach(function (r) { %>
        <li>
          <h3 class="!text-lg"><%= r[0] %></h3>
          <% if (r[1]) { %><p class="mt-1 text-sm <%= b.t.dark ? 'text-white/80' : 'text-ink/70' %>"><%= r[1] %></p><% } %>
        </li>
      <% }) %>
    </ul>
  </div>
</section>
<% } %>
