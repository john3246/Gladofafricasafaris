<% if (d.faqs.length) { %>
<section class="<%= b.t.cls %> py-10 sm:py-14 lg:py-16">
  <div class="container-site max-w-3xl">
    <% if (b.eyebrow) { %><p class="eyebrow"><%= b.eyebrow %></p><% } %>
    <% if (b.heading) { %><h2 class="mt-2 mb-8"><%- b.headingHtml %></h2><% } %>
    <%- include('../partials/faq-list', { faqs: d.faqs }) %>
    <% if (b.buttons.length) { %><div class="mt-6"><%- include('_buttons', { b: b }) %></div><% } %>
  </div>
</section>
<% } %>
