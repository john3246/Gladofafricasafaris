{
  "name": "glad-of-africa-safari",
  "version": "1.0.0",
  "description": "Glad Of Africa Safari & Tours - Tanzania northern circuit safari website",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src --ext js,ejs src/server.js",
    "css:build": "tailwindcss -c tailwind.config.js -i src/styles/input.css -o public/css/app.css --minify",
    "css:watch": "tailwindcss -c tailwind.config.js -i src/styles/input.css -o public/css/app.css --watch",
    "build": "npm run css:build",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "check:size": "node scripts/check-file-size.js",
    "import:live": "node scripts/import/run.js"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.10"
  }
}
