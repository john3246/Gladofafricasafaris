{
  "name": "glad-of-africa-safari",
  "version": "1.0.0",
  "description": "Glad Of Africa Safari & Tours - Tanzania northern circuit safari website",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src --ext js,ejs src/server.js",
    "css:build": "tailwindcss -c tailwind.config.js -i src/styles/input.css -o public/css/app.css --minify",
    "css:watch": "tailwindcss -c tailwind.config.js -i src/styles/input.css -o public/css/app.css --watch",
    "build": "npm run css:build",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "check:size": "node scripts/check-file-size.js",
    "test:cms": "node scripts/cms-smoke-test.js",
    "import:live": "node scripts/import/run.js",
    "db:local": "node scripts/local-db.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "compression": "^1.7.4",
    "cookie-session": "^2.1.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.4.0",
    "flatpickr": "^4.6.13",
    "geoip-lite": "^2.0.3",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.0",
    "pg": "^8.12.0",
    "quill": "^2.0.3",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "jsdom": "^24.1.3",
    "nodemon": "^3.1.4",
    "tailwindcss": "^3.4.10"
  }
}
